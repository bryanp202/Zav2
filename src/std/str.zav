use super::slice::Slice;
use super::mem;
use super::math::max;
use super::fmt::Formatter;

/// A mutatable string
/// Owns the data it holds
pub struct String {
    bytes: *u8;
    capacity: u64;
    len: u64;

    pub fn new() String {
        var self: String = undefined;
        self.bytes = nullptr;
        self.capacity = 0 as u64;
        self.len = 0 as u64;
        return self;
    }

    pub fn free(self: *const String) void {
        @free(self.bytes);
    }

    pub fn clone(self: *const String) String {
        return String::from_slice(self.as_slice());
    }

    pub fn eql(self: *const String, other: *const String) bool {
        if (self.len != other.len) {
            return false;
        }
        if (self.bytes == other.bytes) {
            return true;
        }
        return mem::eql::[u8](self.len, self.bytes, other.bytes);
    }

    pub fn [H] hash(self: *const String, hasher: *const H) u64 {
        return hasher.hash_one(self.bytes, self.len);
    }

    pub fn fmt(self: *const String, fmt: *Formatter) void {
        fmt.slice(self.as_slice());
    } 

    pub fn from_slice(slice: Slice[u8]) String {
        var self: String = undefined;
        self.capacity = slice.len;
        self.len = self.capacity;
        self.bytes = @malloc(self.capacity) as *u8;
        mem::cpy::[u8](slice.len, self.bytes, slice.ptr);
        return self;
    }

    pub fn from_cstr(cstr: CStr) String {
        return String::from_slice(cstr.as_slice());
    }

    pub fn as_ptr(self: *const String) *const u8 {
        return self.bytes;
    }

    /// Return a non-owning slice
    pub fn as_slice(self: *const String) Slice[u8] {
        return Slice::[u8]::new(self.bytes, self.len);
    }

    pub fn append(self: *String, slice: Slice[u8]) void {
        if (self.len + slice.len > self.capacity) {
            self.resize(slice.len);
        }

        mem::cpy::[u8](slice.len, &self.bytes[self.len], slice.ptr);
        self.len += slice.len;
    }

    pub fn append_cstr(self: *String, cstr: CStr) void {
        return self.append(cstr.as_slice());
    }

    pub fn debug(self: *const String) void {
        @printf("\"%.*s\"", self.len, self.bytes);
    }

    /* PRIVATE HELPERS */

    fn resize(self: *String, append_len: u64) void {
        const old_capacity = self.capacity;
        const old_bytes = self.bytes;
        self.capacity = self.capacity != 0 as u64
            ? max::[u64](self.capacity * 2 as u64, self.capacity + append_len)
            : max::[u64](append_len, 8 as u64);
        self.bytes = @malloc(self.capacity) as *u8;
        mem::cpy::[u8](self.len, self.bytes, old_bytes);
        @free(old_bytes);
    }
}

pub struct CString {
    bytes: *u8;
    capacity: u64;
    len: u64;

    pub fn new() CString {
        var self: CString = undefined;
        self.capacity = 8 as u64;
        self.len = 1 as u64;
        self.bytes = @malloc(self.capacity) as *u8;
        self.bytes[0] = 0 as u8;
        return self;
    }

    pub fn free(self: *const CString) void {
        @free(self.bytes);
    }

    pub fn clone(self: *const CString) CString {
        return CString::from_slice(self.as_slice());
    }

    pub fn eql(self: *const CString, other: *const CString) bool {
        if (self.len != other.len) {
            return false;
        }
        if (self.bytes == other.bytes) {
            return true;
        }
        return mem::eql::[u8](self.len, self.bytes, other.bytes);
    }

    pub fn [H] hash(self: *const CString, hasher: *const H) u64 {
        return hasher.hash_one(self.bytes, self.len);
    }

    pub fn fmt(self: *const CString, fmt: *Formatter) void {
        fmt.cstr(self.as_cstr());
    } 

    pub fn from_slice(slice: Slice[u8]) CString {
        var self: CString = undefined;
        self.capacity = slice.len + 1 as u64;
        self.len = self.capacity;
        self.bytes = @malloc(self.capacity) as *u8;
        mem::cpy::[u8](slice.len, self.bytes, slice.ptr);
        // Null terminate it
        self.bytes[slice.len] = 0 as u8;        
        return self;
    }

    pub fn from_cstr(cstr: CStr) CString {
        return CString::from_slice(cstr.as_slice());
    }

    pub fn as_ptr(self: *const CString) *const u8 {
        return self.bytes;
    }

    pub fn as_slice(self: *const CString) Slice[u8] {
        return Slice::[u8]::new(self.bytes, self.len - 1 as u64);
    }

    pub fn as_cstr(self: *const CString) CStr {
        var cstr: CStr = undefined;
        cstr.ptr = self.bytes;
        cstr.len = self.len;
        return cstr;
    }

    pub fn append(self: *CString, slice: Slice[u8]) void {
        if (self.len + slice.len as u64 > self.capacity) {
            self.resize(slice.len as u64);
        }

        mem::cpy::[u8](slice.len, &self.bytes[self.len - 1], slice.ptr);
        self.len += slice.len as u64;
        self.bytes[self.len - 1] = 0 as u8;
    }

    pub fn append_cstr(self: *CString, cstr: CStr) void {
        return self.append(cstr.as_slice());
    }

    pub fn debug(self: *const CString) void {
        @printf("\"%.*s\"", self.len, self.bytes);
    }

    /* PRIVATE HELPERS */

    fn resize(self: *CString, append_len: u64) void {
        const old_capacity = self.capacity;
        const old_bytes = self.bytes;
        self.capacity = self.capacity != 0 as u64
            ? max::[u64](self.capacity * 2 as u64, self.capacity + append_len)
            : max::[u64](append_len, 8 as u64);
        self.bytes = @malloc(self.capacity) as *u8;
        mem::cpy::[u8](self.len, self.bytes, old_bytes);
        @free(old_bytes);
    }
}

// A non-owning view into a null terminated series of bytes
pub struct CStr {
    ptr: *const u8;
    len: u64;

    pub fn unsafe_from_ptr(ptr: *const u8) CStr {
        var self: CStr = undefined;
        self.ptr = ptr;
        self.len = ptr != nullptr ? CStr::unsafe_ptr_len(ptr) : 0 as u64;
        return self;
    }

    pub fn eql(self: *const CStr, other: *const CStr) bool {
        if (self.len != other.len) {
            return false;
        }
        if (self.ptr == other.ptr) {
            return true;
        }
        return mem::eql::[u8](self.len, self.ptr, other.ptr);
    }

    pub fn [H] hash(self: *const CStr, hasher: *const H) u64 {
        return hasher.hash_one(self.ptr, self.len);
    }

    pub fn fmt(self: *const CStr, fmt: *Formatter) void {
        fmt.cstr(self.*);
    } 

    pub fn as_slice(self: *const CStr) Slice[u8] {
        return Slice::[u8]::new(self.ptr, self.len);
    }

    pub fn as_ptr(self: *const CStr) *const u8 {
        return self.ptr;
    }

    pub fn unsafe_eql_ptr(self: *const CStr, ptr: *const u8) bool {
        if (self.ptr == ptr) {
            return true;
        }
        if (ptr == nullptr) {
            return false;
        }
        return mem::eql::[u8](self.len, self.ptr, ptr);
    }

    pub fn debug(self: *const CStr) void {
        @printf("\"%.*s\"", self.len, self.ptr);
    }

    // Public Helpers //

    pub fn unsafe_ptr_len(ptr: *const u8) u64 {
        var i = 0 as u64;
        while (ptr[i] != 0 as u8) {
            i += 1 as u64;
        }
        return i;
    }
}

pub struct Char {
    pub fn is_alpha(c: u32) bool {
        return ('a' <= c and c <= 'z')
            or ('A' <= c and c <= 'Z')
            or c == '_';
    }

    pub fn is_numeric(c: u32) bool {
        return '0' <= c and c <= '9';
    }

    pub fn is_alphanumeric(c: u32) bool {
        return Char::is_alpha(c) or Char::is_numeric(c);
    }
}