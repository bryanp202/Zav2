use super::super::slice::Slice;
use super::super::option::Option;
use super::super::fmt::Formatter;
use super::super::math::max;
use super::super::mem;

use super::super::fmt::IsFormattable;
use super::super::ops::IsCloneable;
use super::super::ops::IsEquatable;
use super::super::ops::HasDefault;
use super::super::ops;

pub struct List[T] {
    items: *T;
    len: u64;
    capacity: u64;

    pub fn new() List[T] {
        var self: List[T] = undefined;
        self.items = nullptr;
        self.len = 0 as u64;
        self.capacity = 0 as u64;
        return self;
    }

    pub fn with_capacity(capacity: u64) List[T] {
        var self: List[T] = undefined;
        self.items = @malloc(@sizeof(self.items.*) * capacity) as *T;
        self.len = 0 as u64;
        self.capacity = capacity;
        return self;
    }

    pub fn free(self: *const List[T]) void {
        compif (T::free) {
            for (0..self.len, self.items) |_, item| {
                item.free();
            }
        }
        @free(self.items);
    }

    pub fn clone(self: *const List[T]) List[T]
    where
        IsCloneable::[T],
    {
        var clone: List[T] = undefined;
        clone.items = @malloc(@sizeof(0 as T) * self.capacity) as *T;
        clone.len = self.len;
        clone.capacity = self.capacity;
        
        for (0..self.len, self.items) |i, item| {
            clone.items[i] = ops::make_clone::[T](item);
        }

        return clone;
    }

    pub fn eql(self: *const List[T], other: *const List[T]) bool
    where
        IsEquatable::[T, T]
    {
        const self_slice = self.as_slice();
        const other_slice = other.as_slice();
        return self_slice.eql(&other_slice);
    }

    pub fn fmt(self: *const List[T], fmt: *Formatter) void
    where
        IsFormattable::[T],
    {
        self.as_slice().fmt(fmt);
    }

    pub fn is_empty(self: *const List[T]) bool {
        return self.len == 0 as u64;
    }

    pub fn clear(self: *List[T]) void {
        self.free();
        self.items = nullptr;
        self.len = 0 as u64;
        self.capacity = 0 as u64;
    }

    pub fn clear_retain_capacity(self: *List[T]) void {
        compif (T::free) {
            for (0..self.len, self.items) |_, item| {
                item.free();
            }
        }
        self.len = 0 as u64;
    }

    pub fn as_slice(self: *const List[T]) Slice[T] {
        return Slice::[T]::new(self.items, self.len);
    }

    pub fn reserve(self: *List[T], count: u64) void
    where
        HasDefault::[T],
    {
        if (count == 0) {
            return;
        }
        if (self.len + count >= self.capacity) {
            self.resize(count);
            for (0..count, &self.items[self.len]) |_, item| {
                item.* = ops::make_default::[T]();
            }
        }
        self.len += count;
    }

    pub fn push(self: *List[T], item: T) void {
        if (self.len == self.capacity) {
            self.resize(1 as u64);
        }
        self.items[self.len] = item;
        self.len += 1 as u64;
    }

    pub fn push_slice(self: *List[T], slice: Slice[T]) void {
        if (self.len + slice.len >= self.capacity) {
            self.resize(slice.len);
        }
        for (self.len..self.len+slice.len, slice.ptr) |i, item| {
            self.items[i] = item.*;
        }
        self.len += slice.len;
    }

    pub fn pop(self: *List[T]) Option[T] {
        if (self.len == 0 as u64) {
            return Option::[T]::None();
        }
        self.len -= 1 as u64;
        return Option::[T]::Some(self.items[self.len]);
    }

    // Pops n items from the list, with no way to free resources.
    pub fn unsafe_npop(self: *List[T], n: u64) void {
        self.len -= n;
    }

    /// Invalid to call on out of bounds index
    pub fn insert(self: *List[T], item: T, index: u64) void {
        if (self.len == self.capacity) {
            self.resize(1 as u64);
        }
        mem::rev_cpy::[T](self.len - index, &self.items[index + 1], &self.items[index]);
        self.items[index] = item;
        self.len += 1 as u64;
    }

    /// Invalid to call on out of bounds index
    pub fn remove(self: *List[T], index: u64) T {
        const item = self.items[index];
        for (0.. self.len-index, &self.items[index]) |_, item| {
            item.* = item[1];
        }
        self.len -= 1 as u64;
        return item;
    }

    /// Invalid to call on out of bounds index
    pub fn replace(self: *List[T], index: u64, item: T) void {
        compif (T::free) {
            self.items[index].free();
        }
        self.items[index] = item;
    }

    /* Private Helpers */

    fn resize(self: *List[T], append_len: u64) void {
        self.capacity = self.capacity != 0 as u64
            ? max::[u64](self.capacity * 2 as u64, self.capacity + append_len)
            : max::[u64](append_len, 8 as u64);
        self.items = @realloc(self.items, @sizeof(self.items.*) * self.capacity) as *T;
    }
}