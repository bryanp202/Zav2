use super::super::option::Option;
use super::super::result::Result;
use super::super::tuple::Tuple2;
use super::super::fmt::Formatter;

use super::super::fmt::IsFormattable;
use super::super::hash::IsHashable;
use super::super::hash::Hasher;
use super::super::hash::hash_one_with;
use super::super::ops::IsCloneable;
use super::super::ops::make_clone;
use super::super::ops::IsEquatable;
use super::super::ops::eql;

/// HashMap owns all values given to it
pub struct HashMap[K, V, H] {
    items: *Entry[K, V];
    capacity: u64;
    len: u64;
    max_density: f64;
    hasher: H;

    pub fn new(hasher: H) HashMap[K, V, H] {
        var self: HashMap[K, V, H] = undefined;
        self.items = nullptr;
        self.capacity = 0 as u64;
        self.len = 0 as u64;
        self.hasher = hasher;
        self.max_density = 0.75;
        
        return self;
    }

    pub fn with_capacity(hasher: H, capacity: u64) HashMap[K, V, H] {
        var self: HashMap[K, V, H] = undefined;
        self.items = @malloc(@sizeof(self.items.*) * capacity) as *Entry[K, V];
        self.len = 0 as u64;
        self.capacity = capacity;
        self.hasher = hasher;
        self.max_density = 0.75;
    
        return self;
    }

    pub fn free(self: *const HashMap[K, V, H]) void {
        for (0..self.capacity, self.items) |_, entry| {
            entry.free();
        }
        @free(self.items);
    }

    pub fn clone(self: *const HashMap[K, V, H]) HashMap[K, V, H]
    where
        IsCloneable::[K],
        IsCloneable::[V],
    {
        var clone: HashMap[K, V, H] = undefined;
        clone.items = @malloc(@sizeof(self.items.*) * self.capacity) as *Entry[K, V];
        clone.len = self.len;
        clone.capacity = self.capacity;
        clone.hasher = self.hasher;
        clone.max_density = self.max_density;

        for (0..self.capacity, self.items) |i, item| {
            clone.items[i] = item.clone();
        }
        return clone;
    }

    pub fn fmt(self: *const HashMap[K, V, H], fmt: *Formatter) void
    where
        IsFormattable::[K],
        IsFormattable::[V],
    {
        if (self.is_empty()) {
            fmt.unsafe_cstr_ptr("[]");
            return;
        }
        fmt.char('[');

        var iter = self.iter();
        const first_entry = iter.next().unwrap();
        fmt.unsafe_cstr_ptr("{ key: ");
        Formatter::format::[K](fmt, &first_entry.key);
        fmt.unsafe_cstr_ptr(", val: ");
        Formatter::format::[V](fmt, &first_entry.val);
        fmt.unsafe_cstr_ptr(" }");

        var curr = iter.next();
        while (curr.is_some()) {
            fmt.unsafe_cstr_ptr(", ");
            const entry = curr.unwrap();

            fmt.unsafe_cstr_ptr("{ key: ");
            Formatter::format::[K](fmt, &entry.key);
            fmt.unsafe_cstr_ptr(", val: ");
            Formatter::format::[V](fmt, &entry.val);
            fmt.unsafe_cstr_ptr(" }");
        } loop curr = iter.next();

        fmt.char(']');
    }

    pub fn is_empty(self: *const HashMap[K, V, H]) bool {
        return self.len == 0 as u64;
    }

    pub fn iter(self: *const HashMap[K, V, H]) EntryIter[K, V] {
        return EntryIter::[K, V]::new(self.capacity, self.items);
    }

    /// Returns the overwritten value, if there is one.
    /// Takes ownership of the key and value
    pub fn insert(self: *HashMap[K, V, H], k: K, v: V) Option[Tuple2[K, V]] {
        if (self.capacity == 0 or (self.len + 1.0) / self.capacity > self.max_density) {
            self.resize();
        }

        const entry = self.make_entry(&k);
        if (entry.type == EntryType::Some) {
            const old_data = Tuple2::[K, V]::new(entry.key, entry.val);
            entry.key = k;
            entry.val = v;
            return Option::[Tuple2[K, V]]::Some(old_data);
        }
        entry.key = k;
        entry.val = v;
        entry.type = EntryType::Some;
        self.len += 1 as u64;

        return Option::[Tuple2[K, V]]::None();
    }

    /// Returns the overwritten value, if there is one
    /// Takes ownership of the key and value
    /// Takes in a hash hint, undefined if hash is incorrect
    pub fn unsafe_insert_with_hash(self: *HashMap[K, V, H], k: K, v: V, k_hash: u64) Option[Tuple2[K, V]] {
        if (self.capacity == 0 or (self.len + 1.0) / self.capacity > self.max_density) {
            self.resize();
        }

        const entry = self.make_entry_with_hash(&k, k_hash);
        if (entry.type == EntryType::Some) {
            const old_data = Tuple2::[K, V]::new(entry.key, entry.val);
            entry.key = k;
            entry.val = v;
            return Option::[Tuple2[K, V]]::Some(old_data);
        }
        entry.key = k;
        entry.val = v;
        entry.type = EntryType::Some;
        self.len += 1 as u64;

        return Option::[Tuple2[K, V]]::None();
    }

    pub fn get(self: *HashMap[K, V, H], k: K) Option[*V] {
        const entry = self.find_entry(&k, hash_one_with::[K, H](&k, &self.hasher));

        if (entry.is_none()) {
            return Option::[*V]::None(); 
        }
        return Option::[*V]::Some(&entry.unwrap().val);
    }

    /// Used to first check if a value exists, and returns a hash hint if not present
    pub fn peek_or_hash(self: *const HashMap[K, V, H], k: K) Result[*const V, u64] {
        const k_hash = hash_one_with::[K, H](&k, &self.hasher);

        const entry = self.find_entry(&k, k_hash);
        if (entry.is_none()) {
            return Result::[*const V, u64]::Err(k_hash);
        }
        return Result::[*const V, u64]::Ok(&entry.unwrap().val);
    }

    /// Must initialize the value if `existed == false`
    pub fn get_or_put(self: *HashMap[K, V, H], k: K) GetOrPutResult[K, V] {
        if (self.capacity == 0 or (self.len + 1.0) / self.capacity > self.max_density) {
            self.resize();
        }

        const entry = self.make_entry(&k);
        const existed = entry.type == EntryType::Some;
        if (!existed) {
            entry.key = k;
            self.len += 1 as u64;
            entry.type = EntryType::Some;
        }
        return GetOrPutResult::[K, V]::new(&entry.key, &entry.val, existed);
    }

   /***********/
   /* Helpers */
   /***********/
    fn resize(self: *HashMap[K, V, H]) void {
        const old_capacity = self.capacity;
        const old_items = self.items;
        self.capacity = old_capacity != 0 ? self.capacity * 2 as u64 : 8 as u64;
        self.items = @calloc(@sizeof(old_items.*), self.capacity) as *Entry[K,V];

        var rem = self.len;
        for (0..old_capacity, old_items) |_, old_entry| {
            if (old_entry.type == EntryType::Some) {
                const entry = self.make_entry_with_hash(&old_entry.key, old_entry.hash);
                entry.* = old_entry.*;
                rem -= 1 as u64;
                if (rem == 0) {
                    break;
                }
            }
        }

        @free(old_items);
    }

    fn make_entry(self: *const HashMap[K, V, H], k: *const K) *Entry[K, V] {
        return self.make_entry_with_hash(k, hash_one_with::[K, H](k, &self.hasher));
    }

    fn make_entry_with_hash(self: *const HashMap[K, V, H], k: *const K, k_hash: u64) *Entry[K, V] {
        var i = k_hash % self.capacity;

        while (self.items[i].type == EntryType::Some) {
            if (self.items[i].eql(k, k_hash)) {
                return &self.items[i];
            }
        } loop i = (i + 1 as u64) % self.capacity;

        const entry = &self.items[i];
        entry.hash = k_hash;

        return entry;
    }

    fn find_entry(self: *const HashMap[K, V, H], k: *const K, k_hash: u64) Option[*Entry[K, V]] {
        if (self.capacity == 0) {
            return Option::[*Entry[K, V]]::None();
        }

        var i = k_hash % self.capacity;

        while (self.items[i].type != EntryType::None) {
            if (self.items[i].type == EntryType::Grave) {
                continue;
            }

            if (self.items[i].eql(k, k_hash)) {
                return Option::[*Entry[K, V]]::Some(&self.items[i]);
            }
        } loop i = (i + 1 as u64) % self.capacity;

        return Option::[*Entry[K, V]]::None();
    }
}

enum EntryType {
    None,
    Grave,
    Some
}

pub struct Entry[K, V] { // TODO ZAV2 make not public
    hash: u64;
    key: K;
    val: V;
    type: EntryType;

    pub fn free(self: *const Entry[K, V]) void {
        if (self.type != EntryType::Some) {
            return;
        }
        compif (K::free) {
            self.key.free();
        }
        compif (V::free) {
            self.val.free();
        }
    }

    pub fn clone(self: *const Entry[K, V]) Entry[K, V]
    where
        IsCloneable::[K],
        IsCloneable::[V],
    {
        var clone: Entry[K, V] = undefined;
        clone.type = self.type;

        if (self.type == EntryType::None) {
            return clone;
        }

        clone.key = make_clone::[K](&self.key);
        clone.val = make_clone::[V](&self.val);

        clone.hash = self.hash;
        return clone;
    }

    pub fn eql(self: *const Entry[K, V], k: *const K, k_hash: u64) bool
    where
        IsEquatable::[K, K],
    {
        return self.hash == k_hash and eql::[K, K](&self.key, k);
    }
}

pub struct EntryIter[K, V] {
    entries: *const Entry[K, V];
    len: u64;
    curr: u64;

    pub fn new(capacity: u64, entries: *const Entry[K, V]) EntryIter[K, V] {
        var self: EntryIter[K, V] = undefined;
        self.len = capacity;
        self.entries = entries;
        self.curr = 0 as u64;
        return self;
    }

    pub fn next(self: *EntryIter[K, V]) Option[*const Entry[K, V]] {
        while (self.curr < self.len) {
            const entry = &self.entries[self.curr];
            if (entry.type == EntryType::Some) {
                self.curr += 1 as u64;
                return Option::[*const Entry[K, V]]::Some(entry);
            }
        } loop self.curr += 1 as u64;

        return Option::[*const Entry[K, V]]::None();
    }
}

struct GetOrPutResult[K, V] {
    key_ptr: *K;
    val_ptr: *V;
    existed: bool;

    pub fn new(key_ptr: *K, val_ptr: *V, existed: bool) GetOrPutResult[K, V] {
        var self: GetOrPutResult[K, V] = undefined;
        self.key_ptr = key_ptr;
        self.val_ptr = val_ptr;
        self.existed = existed;
        return self;
    }
}