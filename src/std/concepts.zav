use super::fmt::Formatter;

pub fn [L, R] Eql() void {
    compif (L::eql(nullptr as *const L, nullptr as *const R): bool) {}
    else {
        nullptr as R == nullptr as L;
        nullptr as R != nullptr as L;
    }
}

pub fn [L, R] Cmp() void {
    compif (L::cmp(nullptr as *const L, nullptr as *const R): Ordering) {}
    else {
        nullptr as R < nullptr as L;
        nullptr as R <= nullptr as L;
        nullptr as R > nullptr as L;
        nullptr as R >= nullptr as L;
        nullptr as R == nullptr as L;
        nullptr as R != nullptr as L;
    }
}

pub fn [H] Hasher() void {
    const _void: void = H::update_state(nullptr as *H, nullptr as *const u8, 0 as u64);
    const _u64: u64 = H::finish(nullptr as *H);
}

pub fn [T] Fmt() void {
    const item: *T = undefined;
    compif (T::fmt(nullptr as *Formatter)) {}
    else compif (item.*.*: u8) {}
    else compif (item.*.*) {}
    else compif (item.*: bool) {}
    else compif (item.*: u8) {}
    else compif (item.*: u16) {}
    else compif (item.*: u32) {}
    else compif (item.*: u64) {}
    else compif (item.*: i8) {}
    else compif (item.*: i16) {}
    else compif (item.*: i32) {}
    else compif (item.*: i64) {}
    else compif (item.*: f32) {}
    else compif (item.*: f64) {}
    else compif (item.*: void) {}
    else {
        return "unsupported type";
    }
}