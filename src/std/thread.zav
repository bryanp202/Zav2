use super::result::Result;
use super::sync::Arc;
use super::time::Duration;

pub enum Error {
    FailedToJoinThread
}

pub fn osId() u64 {
    return @currentThreadId();
}

pub fn sleep(duration: Duration) void {
    @sleep(duration.as_millis_u32());
}

/// Must call either free() or join() to clean up resources
pub struct Thread[I, O] {
    _handle: i64;
    out: Arc[O];

    pub fn new(in: I, worker: fn(I)O) Result[Thread[I, O], I] {
        const thread_args = @malloc(@sizeof(ThreadArgs::[I, O]::new(worker, in))) as *ThreadArgs[I, O];
        thread_args.* = ThreadArgs::[I, O]::new(worker, in);

        var self: Thread[I, O] = undefined;
        self.out = thread_args.out.clone();
        self._handle = @createThread(Thread::[I, O]::worker as fn(*void)i64, thread_args as *void);

        if (self._handle == 0) {
            self.out.unsafe_free_no_clean_up();
            thread_args.out.unsafe_free_no_clean_up();
            return Result::[Thread[I, O], I]::new_err(in);
        }

        return Result::[Thread[I, O], I]::new_ok(self);
    }

    /// Does not free the output value that would be returned by `Thread[I, O]::join`
    pub fn free(self: *const Thread[I, O]) void {
        @closeHandle(self._handle);
        self.out.unsafe_free_no_clean_up();
    }

    /// If join is not called or the value returned from join is not freed,
    /// memory may leak.
    pub fn join(self: *const Thread[I, O]) Result[O, Error] {
        if (@waitOne(self._handle) != 0) {
            return Result::[O, Error]::new_err(Error::FailedToJoinThread);
        }
        return Result::[O, Error]::new_ok(self.out.get().*);
    }

    pub fn eql(self: *const Thread[I, O], other: *const Thread[I, O]) bool {
        return self._handle == other._handle;
    }

    fn worker(args: *ThreadArgs[I, O]) i64 {
        args.out.get().* = args.worker(args.in);
        args.out.unsafe_free_no_clean_up();
        @free(args);
        return 0;
    }
}

struct ThreadArgs[I, O] {
    worker: fn(I)O;
    in: I;
    out: Arc[O];

    pub fn new(worker: fn(I)O, in: I) ThreadArgs[I, O] {
        var self: ThreadArgs[I, O] = undefined;
        self.worker = worker;
        self.in = in;
        self.out = Arc::[O]::unsafe_new_uninit();
        return self;
    }
}

