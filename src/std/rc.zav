use super::ops::IsEquatable;
use super::ops::eql;
use super::hash::IsHashable;
use super::hash::hash_update_with;
use super::fmt::IsFormattable;
use super::fmt::Formatter;

struct RcInternal[T] {
    item: T;
    count: u64;
}

pub struct Rc[T] {
    _inner: *RcInternal[T];

    pub fn new(item: T) Rc[T] {
        var self: Rc[T] = undefined;
        self._inner = @malloc(@sizeof(self._inner.*)) as *RcInternal[T];
        self._inner.item = item;
        self._inner.count = 1 as u64;
        return self;
    }

    pub fn free(self: *const Rc[T]) void {
        self._inner.count -= 1 as u64;
        if (self._inner.count == 0 as u64) {
            compif (T::free) {
                self._inner.item.free();
            }
            @free(self._inner);
        }
    }

    pub fn clone(self: *const Rc[T]) Rc[T] {
        self._inner.count += 1 as u64;
        return self.*;
    }

    pub fn [H] hash(self: *const Rc[T], hasher: *H) void
    where
        IsHashable::[T],
    {
        hash_update_with::[T, H](&self._inner.item, hasher);
    }

    pub fn eql(self: *const Rc[T], other: *const Rc[T]) bool
    where
        IsEquatable::[T, T],
    {
        return eql::[T, T](&self._inner.item, &other._inner.item);
    }

    pub fn fmt(self: *const Rc[T], fmt: *Formatter) void
    where
        IsFormattable::[T],
    {
        Formatter::format::[T](fmt, &self._inner.item);
    }

    pub fn get(self: *const Rc[T]) *T {
        return &self._inner.item;
    }
}