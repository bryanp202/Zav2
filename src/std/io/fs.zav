use super::IoError;
use super::super::result::Result;
use super::super::slice::Slice;
use super::super::str::String;
use super::super::str::CStr;
use super::super::path::PathBuf;

pub struct Bytes {
    ptr: *const u8;
    len: u64;

    pub fn new(ptr: *const u8, len: u64) Bytes {
        var self: Bytes = undefined;
        self.ptr = ptr;
        self.len = len;
        return self;
    }

    pub fn free(self: *const Bytes) void {
        @free(self.ptr);
    }
}

pub struct File {
    _path: PathBuf;
    _handle: i64;

    pub fn open_file(path: CStr) Result[File, IoError] {
        var file: File = undefined;
        file._handle = @fopen(path.as_ptr());
        if (file._handle == -1) {
            return Result::[File, IoError]::Err(IoError::FailedToOpen);
        }
        file._path = PathBuf::from_cstr(path);
        return Result::[File, IoError]::Ok(file);
    }

    pub fn create_file(path: CStr) Result[File, IoError] {
        var file: File = undefined;
        file._handle = @fcreate(path.as_ptr());
        if (file._handle == -1) {
            return Result::[File, IoError]::Err(IoError::FailedToOpen);
        }
        file._path = PathBuf::from_cstr(path);
        return Result::[File, IoError]::Ok(file);
    }

    pub fn write(self: *const File, buf: *const u8, len: i64) Result[i64, i64] {
        var bytes_written = 0;
        const write_result = @fwrite(self._handle, buf, len as u64, &bytes_written);
        if (!write_result) {
            return Result::[i64, i64]::Err(0);
        }
        if (bytes_written != len) {
            return Result::[i64, i64]::Err(bytes_written);
        }
        return Result::[i64, i64]::Ok(bytes_written);
    } 

    pub fn close(self: *const File) bool {
        self._path.free();
        return @closeHandle(self._handle);
    }

    pub fn delete(self: *const File) bool {
        return @fdelete(self._path.as_ptr());
    }
}

pub fn delete_file(path: *const u8) bool {
    return @fdelete(path);
}

/// Returns a string with contents of a file
pub fn read_file(path: CStr) Result[String, IoError] {
    const file = @fopen(path.as_ptr());
    if (file == -1) {
        return Result::[String, IoError]::Err(IoError::FailedToOpen);
    }
    defer @closeHandle(file);

    var file_len: u64 = 0 as u64;
    const read_file_size_success  = @fgetSize(file, &file_len);
    if (!read_file_size_success) {
        return Result::[String, IoError]::Err(IoError::FileEmpty);
    }

    var file_buf = String::with_capacity(file_len);
    if (file_buf.bytes == nullptr) {
        return Result::[String, IoError]::Err(IoError::OutOfMemory);
    }

    var bytes_read: u64 = 0 as u64;
    const read_success = @fread(file, file_buf.bytes, file_len, &bytes_read);
    if (!read_success or bytes_read != file_len) {
        file_buf.free();
        return Result::[String, IoError]::Err(IoError::FailedToRead);
    }
    file_buf.len += bytes_read;

    return Result::[String, IoError]::Ok(file_buf);
}

pub fn read_bytes(path: *const u8) Result[Bytes, IoError] {
    const file = @fopen(path);
    if (file == -1) {
        return Result::[Bytes, IoError]::Err(IoError::FailedToOpen);
    }
    defer @closeHandle(file);

    var file_len: u64 = 0 as u64;
    const read_file_size_success  = @fgetSize(file, &file_len);
    if (!read_file_size_success) {
        return Result::[Bytes, IoError]::Err(IoError::FileEmpty);
    }

    const file_buf = @malloc(file_len) as *u8;
    if (file_buf == nullptr) {
        return Result::[Bytes, IoError]::Err(IoError::OutOfMemory);
    }

    var bytes_read: u64 = 0 as u64;
    const read_success = @fread(file, file_buf, file_len, &bytes_read);
    if (!read_success or bytes_read != file_len) {
        @free(file_buf);
        return Result::[Bytes, IoError]::Err(IoError::FailedToRead);
    }

    return Result::[Bytes, IoError]::Ok(
        Bytes::new(file_buf, bytes_read)
    );
}