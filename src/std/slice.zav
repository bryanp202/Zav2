use super::option::Option;
use super::mem;
use super::hash;
use super::str;
use super::fmt::Formatter;

use super::fmt::IsFormattable;
use super::hash::Hasher;
use super::hash::IsHashable;
use super::hash::hash_update_with;
use super::ops::IsEquatable;
use super::ops::eql;

pub struct SplitIterator[T] {
    curr: *const T;
    remaining: u64;
    pred: fn(*const T)bool;

    pub fn next(self: *SplitIterator[T]) Option[Slice[T]] {
        for (1..self.remaining + 1, self.curr) |i, item| {
            if (!self.pred(item)) continue;

            const ptr = self.curr;
            self.curr = self.curr + @sizeof(self.curr.*) * i;
            self.remaining -= i as u64;
            return Option::[Slice[T]]::Some(Slice::[T]::new(ptr, (i - 1) as u64));
        }

        if (self.curr != nullptr) {
            const old_curr = self.curr;
            const old_remaining = self.remaining;
            self.curr = nullptr;
            self.remaining = 0 as u64;
            return Option::[Slice[T]]::Some(Slice::[T]::new(old_curr, old_remaining));
        }
        return Option::[Slice[T]]::None();
    } 
}

pub struct Slice[T] {
    ptr: *const T;
    len: u64;

    pub fn new(ptr: *const T, len: u64) Slice[T] {
        var slice: Slice[T] = undefined;
        slice.ptr = ptr;
        slice.len = len;
        return slice;
    }

    pub fn split(self: *const Slice[T], pred: fn(*const T)bool) SplitIterator[T] {
        var iter: SplitIterator[T] = undefined;
        iter.curr = self.ptr;
        iter.remaining = self.len;
        iter.pred = pred;
        return iter;
    }

    pub fn eql(self: *const Slice[T], other: *const Slice[T]) bool
    where
        IsEquatable::[T, T],
    {
        if (self.len != other.len) {
            return false;
        }
        if (self.ptr == other.ptr) {
            return true;
        }

        for (0..self.len, self.ptr) |i, item| {
            if (eql::[T, T](item, &other.ptr[i])) {
                return false;
            }
        }
        return true;
    }

    pub fn [H] hash(self: *const Slice[T], hasher: *H) void
    where
        IsHashable::[T],
        Hasher::[H],
    {
        for (0..self.len, self.ptr) |_, item| {
            hash_update_with::[T, H](item, hasher);
        }
    }

    pub fn fmt(self: *const Slice[T], fmt: *Formatter) void
    where
        IsFormattable::[T],
    {
        if (self.len == 0 as u64) {
            fmt.unsafe_cstr_ptr("[]");
            return;
        }

        compif (nullptr as T: u8) {
            fmt.char('"');
            fmt.slice(self.*);
            fmt.char('"');
        } else compif (Formatter::format::[T]) {
            fmt.unsafe_cstr_ptr("[");
            Formatter::format::[T](fmt, &self.ptr[0]);
            for (1..self.len, &self.ptr[1]) |_, item| {
                fmt.unsafe_cstr_ptr(", ");
                Formatter::format::[T](fmt, item);
            }
            fmt.unsafe_cstr_ptr("]");
        }
    }
}