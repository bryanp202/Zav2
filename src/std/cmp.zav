use super::slice::Slice;

pub enum Ordering {
    Less,
    Equal,
    Greater
}

// Sorts the slice in place
pub fn [T] sort(items: *T, n: u64) void {
    quick_sort::[T](items, n);
}

fn [T] quick_sort(items: *T, n: i64) void {
    if (n > 1) {
        const split = quick_sort_partition::[T](items, n);
        quick_sort::[T](items, split + 1);
        quick_sort::[T](&items[split + 1], n - split - 1);
    }
}

fn [T] quick_sort_partition(items: *T, n: i64) i64 {
    const pivot = &items[0];
    var i = -1;
    var j = n;
    while (true) {
        i += 1;
        compif (T::cmp) {
            while (i < n and items[i].cmp(pivot) == Ordering::Less) {
                i += 1;
            }
        } else {
            while (i < n and items[i] < pivot.*) {
                i += 1;
            }
        }

        j -= 1;
        compif (T::cmp) {
            while (j >= 0 and items[j].cmp(pivot) == Ordering::Greater) {
                j -= 1;
            }
        } else {
            while (j >= 0 and items[j] > pivot.*) {
                j -= 1;
            }
        }

        if (i >= j) return j;

        const temp = items[i];
        items[i] = items[j];
        items[j] = temp;
    }
}