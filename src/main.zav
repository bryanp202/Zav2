pub mod std;
pub mod args;
pub mod ast;

pub fn main(argc: i64, argv: **u8) i64 {
    const start = std::time::Instant::now();
    defer @printf("Time to run: %f s\n", start.elapsed().as_secs_f64());
    
    const settings = args::ArgsParser::new(argc, argv)
        .parse();
    defer settings.debug();

    if (settings.display_help) {
        args::display_help();
        return 1;
    }

    for (0..100_000) |_| {
        test(&settings);
    }

    return 0;
}
use args::CompileSettings;
fn test(settings: *const CompileSettings) i64 {
    const result = ast::parser::Parser::parse(std::path::PathBuf::from_cstr(settings.root_path));
    if (result.is_err()) {
        return 1;
    }
    const parse_result = result.unwrap_ok();
    defer parse_result.free();

    var fmt = std::fmt::Formatter::new_for_terminal();
    defer fmt.free();
    parse_result.error_cache.fmt(&fmt);
    fmt.print();

    return 0;
}