use ::std::fmt::Formatter;

use super::Ast;
use super::AstNodeType;
use super::AstNodeIndex;
use super::OptionalAstNodeIndex;
use super::AstExtraIndex;
use super::SpanIndex;
use super::OptionalSpanIndex;
use super::symbol::Symbol;

pub struct VoidType {
    type: AstNodeType;
    pan: u16;
    span: SpanIndex;

    pub fn new(span: SpanIndex) VoidType {
        var self: VoidType = undefined;
        self.type = AstNodeType::VoidType;
        self.pan = 0 as u16;
        self.span = span;
        return self;
    }
}

pub struct BoolType {
    type: AstNodeType;
    pad: u16;
    span: SpanIndex;

    pub fn new(span: SpanIndex) BoolType {
        var self: BoolType = undefined;
        self.type = AstNodeType::BoolType;
        self.pad = 0 as u16;
        self.span = span;
        return self;
    }
}

pub struct IntType {
    type: AstNodeType;
    bits: u16;
    span: SpanIndex;

    pub fn new(span: SpanIndex, bits: u16) IntType {
        var self: IntType = undefined;
        self.type = AstNodeType::IntType;
        self.bits = bits;
        self.span = span;
        return self;
    }

    pub fn fmt(self: *const IntType, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("i");
        fmt.uint(self.bits);
    }
}

pub struct UintType {
    type: AstNodeType;
    bits: u16;
    span: SpanIndex;

    pub fn new(span: SpanIndex, bits: u16) UintType {
        var self: UintType = undefined;
        self.type = AstNodeType::UintType;
        self.bits = bits;
        self.span = span;
        return self;
    }

    pub fn fmt(self: *const UintType, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("u");
        fmt.uint(self.bits);
    }
}

pub struct FloatType {
    type: AstNodeType;
    bits: u16;
    span: SpanIndex;

    pub fn new(span: SpanIndex, bits: u16) FloatType {
        var self: FloatType = undefined;
        self.type = AstNodeType::FloatType;
        self.bits = bits;
        self.span = span;
        return self;
    }

    pub fn fmt(self: *const FloatType, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("f");
        fmt.uint(self.bits);
    }
}

pub struct PtrType {
    type: AstNodeType;
    mutable: bool;
    pad: u8;
    span: SpanIndex;
    // child: AstNodeIndex (always +1);

    pub fn new(span: SpanIndex, mutable: bool) PtrType {
        var self: PtrType = undefined;
        self.type = AstNodeType::PtrType;
        self.pad = 0 as u8;
        self.mutable = mutable;
        self.span = span;
        return self;
    }

    pub fn fmt(self: *const PtrType, fmt: *Formatter, ast: *const Ast, index: u64) void {
        if (self.mutable) {
            fmt.unsafe_cstr_ptr("*");
        } else {
            fmt.unsafe_cstr_ptr("*const ");
        }
        ast.display_next_node(fmt, index, @sizeof(self.*));
    }
}

pub struct ArrayType {
    type: AstNodeType;
    pad: u16;
    span: SpanIndex;
    // len: AstNodeIndex; (always +1) // const expr
    child: AstNodeIndex;

    pub fn new(span: SpanIndex, child: AstNodeIndex) ArrayType {
        var self: ArrayType = undefined;
        self.type = AstNodeType::ArrayType;
        self.pad = 0 as u16;
        self.span = span;
        self.child = child;
        return self;
    }

    pub fn fmt(self: *const ArrayType, fmt: *Formatter, ast: *const Ast, index: u64) void {
        fmt.unsafe_cstr_ptr("[");
        ast.display_next_node(fmt, index, @sizeof(self.*));
        fmt.unsafe_cstr_ptr("]");
        ast.display_node(fmt, self.child._private_index);
    }
}

pub struct FnType {
    type: AstNodeType;
    param_count: u16;
    span: SpanIndex;
    params: AstExtraIndex;
    ret_type: AstNodeIndex;

    pub fn new(
        span: SpanIndex,
        param_count: u16,
        params: AstExtraIndex,
        ret_type: AstNodeIndex,
    ) FnType {
        var self: FnType = undefined;
        self.type = AstNodeType::FnType;
        self.param_count = param_count;
        self.span = span;
        self.params = params;
        self.ret_type = ret_type;
        return self;
    }

    pub fn fmt(self: *const FnType, fmt: *Formatter, ast: *const Ast) void {
        fmt.unsafe_cstr_ptr("fn(");
        if (self.param_count >= 1) {
            ast.display_node(fmt, ast.extra.items[self.params._private_index]);
            for (1..self.param_count, &ast.extra.items[self.params._private_index + 1]) |_, param| {
                fmt.unsafe_cstr_ptr(", ");
                ast.display_node(fmt, param.*);
            }
        }
        fmt.unsafe_cstr_ptr(")");
        ast.display_node(fmt, self.ret_type._private_index);
    }
}

pub struct TupleType {
    type: AstNodeType;
    field_count: u16;
    span: SpanIndex;
    fields: AstExtraIndex; // list of types

    pub fn new(span: SpanIndex, field_count: u16, fields: AstExtraIndex) TupleType {
        var self: TupleType = undefined;
        self.type = AstNodeType::TupleType;
        self.field_count = field_count;
        self.span = span;
        self.fields = fields;
        return self;
    }

    pub fn fmt(self: *const TupleType, fmt: *Formatter, ast: *const Ast) void {
        fmt.unsafe_cstr_ptr("(");
        if (self.field_count >= 1) {
            ast.display_node(fmt, ast.extra.items[self.fields._private_index]);
            for (1..self.field_count, &ast.extra.items[self.fields._private_index + 1]) |_, param| {
                fmt.unsafe_cstr_ptr(", ");
                ast.display_node(fmt, param.*);
            }
        }
        fmt.unsafe_cstr_ptr(")");
    }
}

pub struct IdentType {
    type: AstNodeType;
    pad: u16;
    span: SpanIndex;
    sym: Symbol;

    pub fn new(span: SpanIndex, sym: Symbol) IdentType {
        var self: IdentType = undefined;
        self.type = AstNodeType::IdentType;
        self.pad = 0 as u16;
        self.span = span;
        self.sym = sym;
        return self;
    }

    pub fn fmt(self: *const IdentType, fmt: *Formatter, ast: *const Ast) void {
        fmt.slice(ast.interner.get(self.sym));
    }
}

pub struct GenericType {
    type: AstNodeType;
    generic_count: u16;
    span: SpanIndex;
    sym: Symbol;
    generics: AstExtraIndex;

    pub fn new(
        span: SpanIndex,
        sym: Symbol,
        generic_count: u16,
        generics: AstExtraIndex,
    ) GenericType {
        var self: GenericType = undefined;
        self.type = AstNodeType::GenericType;
        self.generic_count = generic_count;
        self.span = span;
        self.sym = sym;
        self.generics = generics;
        return self;
    }

    pub fn fmt(self: *const GenericType, fmt: *Formatter, ast: *const Ast) void {
        fmt.slice(ast.interner.get(self.sym));
        fmt.unsafe_cstr_ptr("[");
        if (self.generic_count >= 1) {
            ast.display_node(fmt, ast.extra.items[self.generics._private_index]);
            for (1..self.generic_count, &ast.extra.items[self.generics._private_index + 1]) |_, generic| {
                fmt.unsafe_cstr_ptr(", ");
                ast.display_node(fmt, generic.*);
            }
        }
        fmt.unsafe_cstr_ptr("]");
    }
}

// Size must be >= size of `GenericType`
pub struct ScopedType {
    type: AstNodeType;
    absolute: bool;
    scope_count: u8; // at least 1
    span: SpanIndex;
    scopes: AstExtraIndex; // IdentType or GenericType
    pad: u32; // make size same as `GenericType`

    pub fn new(span: SpanIndex, absolute: bool, scope_count: u8, scopes: AstExtraIndex) ScopedType {
        var self: ScopedType = undefined;
        self.type = AstNodeType::ScopedType;
        self.absolute = absolute;
        self.scope_count = scope_count;
        self.span = span;
        self.scopes = scopes;
        self.pad = 0 as u32;
        return self;
    }

    pub fn fmt(self: *const ScopedType, fmt: *Formatter, ast: *const Ast) void {
        if (self.absolute) {
            fmt.unsafe_cstr_ptr("::");
        }
        ast.display_node(fmt, ast.extra.items[self.scopes._private_index]);
        for (1..self.scope_count, &ast.extra.items[self.scopes._private_index + 1]) |_, type| {
            fmt.unsafe_cstr_ptr("::");
            ast.display_node(fmt, type.*);   
        }
    }
}