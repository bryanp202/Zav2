use ::std::fmt::Formatter;

use super::Ast;
use super::AstNodeType;
use super::AstNodeIndex;
use super::OptionalAstNodeIndex;
use super::AstExtraIndex;
use super::SpanIndex;
use super::OptionalSpanIndex;
use super::Identifier;
use super::Parameter;
use super::symbol::Symbol;

pub struct DeclItem {
    type: AstNodeType;
    public: bool;
    mutable: bool;
    // pattern: AstNodeIndex; (always +1);
    ty: OptionalAstNodeIndex;
    expr: OptionalAstNodeIndex;

    pub fn new(
        public: bool,
        mutable: bool,
        ty: OptionalAstNodeIndex,
        expr: OptionalAstNodeIndex,
    ) DeclItem {
        var self: DeclItem = undefined;
        self.type = AstNodeType::DeclItem;
        self.public = public;
        self.mutable = mutable;
        self.ty = ty;
        self.expr = expr;
        return self;
    }

    pub fn fmt(self: *const DeclItem, fmt: *Formatter, ast: *const Ast, index: u64, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr(self.mutable ? "var " as *const u8 : "const " as *const u8);
        ast.display_next_node(fmt, index, @sizeof(self.*), indent);
        if (self.ty.is_some()) {
            fmt.unsafe_cstr_ptr(": ");
            ast.display_node(fmt, self.ty._private_index, indent);
        }
        fmt.unsafe_cstr_ptr(" = ");
        if (self.expr.is_some()) {
            ast.display_node(fmt, self.expr._private_index, indent);
        } else {
            fmt.unsafe_cstr_ptr("undefined");
        }
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct ModuleItem {
    type: AstNodeType;
    pad: u8;
    public: bool;
    name_span: SpanIndex;
    name_sym: Symbol;

    pub fn new(public: bool, name_span: SpanIndex, name_sym: Symbol) ModuleItem {
        var self: ModuleItem = undefined;
        self.type = AstNodeType::ModuleItem;
        self.pad = 0 as u8;
        self.public = public;
        self.name_span = name_span;
        self.name_sym = name_sym;
        return self;
    }

    pub fn fmt(self: *const ModuleItem, fmt: *Formatter, ast: *const Ast) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("mod ");
        fmt.slice(ast.interner.get(self.name_sym));
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct FnItem {
    type: AstNodeType;
    pad: u16;
    public: bool;
    generic_count: u8;
    param_count: u8;
    where_count: u8;
    name_span: SpanIndex;
    name_sym: Symbol;
    generics: AstExtraIndex; // list of Identifier
    params: AstExtraIndex; // list of Parameter
    wheres: AstExtraIndex; // list of AstNode (exprs)
    ret_type: AstNodeIndex;
    body: AstNodeIndex;

    pub fn new(
        public: bool,
        generic_count: u8,
        param_count: u8,
        where_count: u8,
        name_span: SpanIndex,
        name_sym: Symbol,
        generics: AstExtraIndex,
        params: AstExtraIndex,
        wheres: AstExtraIndex,
        ret_type: AstNodeIndex,
        body: AstNodeIndex,
    ) FnItem {
        var self: FnItem = undefined;
        self.type = AstNodeType::FnItem;
        self.pad = 0 as u16;
        self.public = public;
        self.generic_count = generic_count;
        self.param_count = param_count;
        self.where_count = where_count;
        self.name_span = name_span;
        self.name_sym = name_sym;
        self.generics = generics;
        self.params = params;
        self.wheres = wheres;
        self.ret_type = ret_type;
        self.body = body;
        return self;
    }

    pub fn fmt(self: *const FnItem, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("fn ");

        if (self.generic_count > 0) {
            fmt.unsafe_cstr_ptr("[");
            const first_ident = &ast.extra.items[self.generics._private_index] as *Identifier;
            first_ident.fmt(fmt, ast);
            for (1..self.generic_count, &first_ident[1]) |_, generic| {
                fmt.unsafe_cstr_ptr(", ");
                generic.fmt(fmt, ast);
            }
            fmt.unsafe_cstr_ptr("]");
        }

        fmt.slice(ast.interner.get(self.name_sym));
        fmt.unsafe_cstr_ptr("(");
        if (self.param_count > 0) {
            const first_param = &ast.extra.items[self.params._private_index] as *Parameter;
            first_param.fmt(fmt, ast, indent);
            for (1..self.param_count, &first_param[1]) |_, param| {
                fmt.unsafe_cstr_ptr(", ");
                param.fmt(fmt, ast, indent);
            }
        }
        fmt.unsafe_cstr_ptr(") ");
        ast.display_node(fmt, self.ret_type._private_index, indent);

        if (self.where_count > 0) {
            fmt.newline();
            Ast::fmt_indent(fmt, indent);
            fmt.unsafe_cstr_ptr("where");
            fmt.newline();

            const where_clause_indent = indent + 1 as u8;
            const first_where = &ast.extra.items[self.params._private_index];
            for (0..self.where_count, first_where) |_, where_clause| {
                Ast::fmt_indent(fmt, where_clause_indent);
                ast.display_node(fmt, where_clause.*, indent);
                fmt.unsafe_cstr_ptr(",");
                fmt.newline();
            }
        } else {
            fmt.unsafe_cstr_ptr(" ");
        }
        ast.display_node(fmt, self.body._private_index, indent);
    }
}

pub struct StructItem {
    type: AstNodeType;
    public: bool;
    generic_count: u8;
    field_count: u16;
    pad: u16;
    name_span: SpanIndex;
    name_sym: Symbol;
    generics: AstExtraIndex; // list of AstNode (items)
    fields: AstExtraIndex; // list of Field

    pub fn new(
        public: bool,
        generic_count: u8,
        field_count: u16,
        name_span: SpanIndex,
        name_sym: Symbol,
        generics: AstExtraIndex,
        fields: AstExtraIndex,
    ) StructItem {
        var self: StructItem = undefined;
        self.type = AstNodeType::StructItem;
        self.public = public;
        self.generic_count = generic_count;
        self.field_count = field_count;
        self.pad = 0 as u16;
        self.name_span = name_span;
        self.name_sym = name_sym;
        self.generics = generics;
        self.fields = fields;
        return self;
    }

    pub fn fmt(self: *const StructItem, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("struct ");
        fmt.slice(ast.interner.get(self.name_sym));

        if (self.generic_count > 0) {
            fmt.unsafe_cstr_ptr("[");
            const first_generic = &ast.extra.items[self.generics._private_index] as *Identifier;
            first_generic.fmt(fmt, ast);
            for (1..self.generic_count, &first_generic[1]) |_, generic| {
                fmt.unsafe_cstr_ptr(", ");
                generic.fmt(fmt, ast);
            }
            fmt.unsafe_cstr_ptr("]");
        }

        fmt.unsafe_cstr_ptr(" {");
        if (self.field_count > 0) {
            fmt.newline();
            const field_indent = indent + 1 as u8;
            for (0..self.field_count, &ast.extra.items[self.fields._private_index]) |_, field| {
                Ast::fmt_indent(fmt, field_indent);
                ast.display_node(fmt, field.*, field_indent);
                fmt.newline();
            }
        }
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct UnionItem {
    type: AstNodeType;
    public: bool;
    generic_count: u8;
    field_count: u16;
    pad: u16;
    name_span: SpanIndex;
    name_sym: Symbol;
    generics: AstExtraIndex; // list of Identifier
    fields: AstExtraIndex; // list of Items

    pub fn new(
        public: bool,
        generic_count: u8,
        field_count: u16,
        name_span: SpanIndex,
        name_sym: Symbol,
        generics: AstExtraIndex,
        fields: AstExtraIndex,
    ) UnionItem {
        var self: UnionItem = undefined;
        self.type = AstNodeType::UnionItem;
        self.public = public;
        self.generic_count = generic_count;
        self.field_count = field_count;
        self.pad = 0 as u16;
        self.name_span = name_span;
        self.name_sym = name_sym;
        self.generics = generics;
        self.fields = fields;
        return self;
    }

    pub fn fmt(self: *const UnionItem, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("union ");
        fmt.slice(ast.interner.get(self.name_sym));

        if (self.generic_count > 0) {
            fmt.unsafe_cstr_ptr("[");
            const first_generic = &ast.extra.items[self.generics._private_index] as *Identifier;
            first_generic.fmt(fmt, ast);
            for (1..self.generic_count, &first_generic[1]) |_, generic| {
                fmt.unsafe_cstr_ptr(", ");
                generic.fmt(fmt, ast);
            }
            fmt.unsafe_cstr_ptr("]");
        }

        fmt.unsafe_cstr_ptr(" {");
        if (self.field_count > 0) {
            fmt.newline();
            const field_indent = indent + 1 as u8;
            for (0..self.field_count, &ast.extra.items[self.fields._private_index]) |_, field| {
                Ast::fmt_indent(fmt, field_indent);
                ast.display_node(fmt, field.*, field_indent);
                fmt.newline();
            }
        }
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct EnumItem {
    type: AstNodeType;
    pad: u8;
    public: bool;
    name_span: SpanIndex;
    name_sym: Symbol;
    variant_count: u32;
    variants: AstExtraIndex; // list of Identifier

    pub fn new(
        public: bool,
        name_span: SpanIndex,
        name_sym: Symbol,
        variant_count: u32,
        variants: AstExtraIndex,
    ) EnumItem {
        var self: EnumItem = undefined;
        self.type = AstNodeType::EnumItem;
        self.pad = 0 as u8;
        self.public = public;
        self.name_span = name_span;
        self.name_sym = name_sym;
        self.variant_count = variant_count;
        self.variants = variants;
        return self;
    }

    pub fn fmt(self: *const EnumItem, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("enum {");
        if (self.variant_count > 0) {
            const variant_indent = indent + 1 as u8;
            for (0..self.variant_count, &ast.extra.items[self.variants._private_index] as *Identifier) |_, ident| {
                fmt.newline();
                Ast::fmt_indent(fmt, variant_indent);
                ident.fmt(fmt, ast);
                fmt.unsafe_cstr_ptr(",");
            }
            fmt.newline();
            Ast::fmt_indent(fmt, indent);
        }
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct UseItem {
    type: AstNodeType;
    public: bool;
    global: bool;
    // tree: UseTree (always +1);

    pub fn new(public: bool, global: bool) UseItem {
        var self: UseItem = undefined;
        self.type = AstNodeType::UseItem;
        self.public = public;
        self.global = global;
        return self;
    }

    pub fn fmt(self: *const UseItem, fmt: *Formatter, ast: *const Ast, index: u64, indent: u64) void {
        if (self.public) {
            fmt.unsafe_cstr_ptr("pub ");
        }
        fmt.unsafe_cstr_ptr("use ");
        if (self.global) {
            fmt.unsafe_cstr_ptr("::");
        }
        ast.display_next_node(fmt, @sizeof(self.*), index, indent);
    }
}

pub struct UseTree {
    type: AstNodeType;
    segment_count: u16;
    segments: AstExtraIndex; // list of Identifiers
    // end: AstNodeIndex (always +1); // UseTreeSimple or UseTreeNested


    pub fn new(segment_count: u16, segments: AstExtraIndex) UseTree {
        var self: UseTree = undefined;
        self.type = AstNodeType::UseTree;
        self.segment_count = segment_count;
        self.segments = segments;
        return self;
    }

    pub fn fmt(self: *const UseTree, fmt: *Formatter, ast: *const Ast, index: u64, indent: u64) void {
        if (self.segment_count > 0) {
            const first_segment = &ast.extra.items[self.segments._private_index] as *Identifier;
            first_segment.fmt(fmt, ast);
            for (1..self.segment_count, &first_segment[1]) |_, segment| {
                fmt.unsafe_cstr_ptr("::");
                segment.fmt(fmt, ast);
            }
        }
        ast.display_next_node(fmt, index, @sizeof(self.*), indent);
    }
}

pub struct UseTreeSimple {
    type: AstNodeType;
    rename_span: OptionalSpanIndex;
    rename_sym: Symbol;

    pub fn new(rename_span: OptionalSpanIndex, rename_sym: Symbol) UseTreeSimple {
        var self: UseTreeSimple = undefined;
        self.rename_span = rename_span;
        self.rename_sym = rename_sym;
        return self;
    }

    pub fn fmt(self: *const UseTreeSimple, fmt: *Formatter, ast: *const Ast) void {
        if (self.rename_span.is_some()) {
            fmt.unsafe_cstr_ptr(" as ");
            fmt.slice(ast.interner.get(self.rename_sym));
        }
    }
}

pub struct UseTreeNested {
    type: AstNodeType;
    nested_count: u16;
    nested: AstExtraIndex; // list of UseTree

    pub fn new(nested_count: u16, nested: AstExtraIndex) UseTreeNested {
        var self: UseTreeNested = undefined;
        self.type = AstNodeType::UseTreeNested;
        self.nested_count = nested_count;
        self.nested = nested;
        return self;
    }

    pub fn fmt(self: *const UseTreeNested, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("::{");
        if (self.nested_count > 0) {
            const first_nested = &ast.extra.items[self.nested._private_index];
            ast.display_node(fmt, first_nested.*, indent);
            for (1..self.nested_count, &first_nested[1]) |_, nested| {
                fmt.unsafe_cstr_ptr(", ");
                ast.display_node(fmt, nested.*, indent);
            }
        }
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct StructureField {
    type: AstNodeType;
    pad: u16;
    name_span: SpanIndex;
    name_sym: Symbol;
    ty: AstNodeIndex;

    pub fn new(name_span: SpanIndex, name_sym: Symbol, ty: AstNodeIndex) StructureField {
        var self: StructureField = undefined;
        self.type = AstNodeType::StructureField;
        self.pad = 0 as u16;
        self.name_span = name_span;
        self.name_sym = name_sym;
        self.ty = ty;
        return self;
    }

    pub fn fmt(self: *const StructureField, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.slice(ast.interner.get(self.name_sym));
        fmt.unsafe_cstr_ptr(": ");
        ast.display_node(fmt, self.ty._private_index, indent);
        fmt.unsafe_cstr_ptr(";");
    }
}