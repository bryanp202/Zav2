//! Unsafe to have implicit stmt in node.
//! No guarantee that parent node comes first.

use ::std::fmt::Formatter;

use super::Ast;
use super::AstNodeType;
use super::AstNodeIndex;
use super::OptionalAstNodeIndex;
use super::AstExtraIndex;
use super::SpanIndex;
use super::Identifier;

fn stmt_is_type(ast: *const Ast, index: u64, expected: AstNodeType) bool {
    return (&ast.nodes.items[index] as *const ItemStmt).type == expected;
}

pub struct ItemStmt {
    type: AstNodeType;
    pad: u16;
    // item: AstNodeIndex (always +1);

    pub fn new() ItemStmt {
        var self: ItemStmt = undefined;
        self.type = AstNodeType::ItemStmt;
        self.pad = 0 as u16;
        return self;
    }

    pub fn fmt(self: *const ItemStmt, fmt: *Formatter, ast: *const Ast, index: u64, indent: u64) void {
        ast.display_next_node(fmt, index, @sizeof(self.*), indent);
    }
}

pub struct DeferStmt {
    type: AstNodeType;
    pad: u8;
    is_err: bool;
    expr: AstNodeIndex;

    pub fn new(is_err: bool, expr: AstNodeIndex) DeferStmt {
        var self: DeferStmt = undefined;
        self.type = AstNodeType::DeferStmt;
        self.pad = 0 as u8;
        self.is_err = is_err;
        self.expr = expr;
        return self;
    }

    pub fn fmt(self: *const DeferStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr(self.is_err ? "edefer " as *const u8 : "defer " as *const u8);
        ast.display_node(fmt, self.expr._private_index, indent);
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct DeclStmt {
    type: AstNodeType;
    pad: u8;
    is_mutable: bool;
    // pattern: AstNodeIndex (always +1);
    decl_type: OptionalAstNodeIndex;
    expr: OptionalAstNodeIndex;

    pub fn new(is_mutable: bool, decl_type: OptionalAstNodeIndex, expr: OptionalAstNodeIndex) DeclStmt {
        var self: DeclStmt = undefined;
        self.type = AstNodeType::DeclStmt;
        self.pad = 0 as u8;
        self.is_mutable = is_mutable;
        self.decl_type = decl_type;
        self.expr = expr;
        return self;
    }

    pub fn fmt(self: *const DeclStmt, fmt: *Formatter, ast: *const Ast, index: u64, indent: u64) void {
        fmt.unsafe_cstr_ptr(self.is_mutable ? "var " as *const u8 : "const " as *const u8);
        ast.display_next_node(fmt, index, @sizeof(self.*), indent);
        if (self.decl_type.is_some()) {
            fmt.unsafe_cstr_ptr(": ");
            ast.display_node(fmt, self.decl_type._private_index, indent);
        }
        fmt.unsafe_cstr_ptr(" = ");
        if (self.expr.is_some()) {
            ast.display_node(fmt, self.expr._private_index, indent);
        } else {
            fmt.unsafe_cstr_ptr("undefined");
        }
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct AssignStmt {
    type: AstNodeType;
    assign_op: AssignOp;
    lhs: AstNodeIndex;
    rhs: AstNodeIndex;

    pub fn new(assign_op: AssignOp, lhs: AstNodeIndex, rhs: AstNodeIndex) AssignStmt {
        var self: AssignStmt = undefined;
        self.type = AstNodeType::AssignStmt;
        self.assign_op = assign_op;
        self.lhs = lhs;
        self.rhs = rhs;
        return self;
    }

    pub fn fmt(self: *const AssignStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        ast.display_node(fmt, self.lhs._private_index, indent);
        var op: *const u8 = undefined;
        switch (self.assign_op) {
            AssignOp::Equal => op = "";
            AssignOp::BitOr => op = "|";
            AssignOp::BitXor => op = "^";
            AssignOp::BitAnd => op = "&";
            AssignOp::ShiftR => op = ">>";
            AssignOp::ShiftL => op = "<<";
            AssignOp::TermAdd => op = "+";
            AssignOp::TermSub => op = "-";
            AssignOp::FactorMul => op = "*";
            AssignOp::FactorDiv => op = "/";
            AssignOp::FactorMod => op = "%";
            else => @abort("invalid AssignOp: %llu\n", self.assign_op);
        }
        fmt.unsafe_cstr_ptr(" ");
        fmt.unsafe_cstr_ptr(op);
        fmt.unsafe_cstr_ptr("= ");
        ast.display_node(fmt, self.rhs._private_index, indent);
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct ExprStmt {
    type: AstNodeType;
    pad: u16;
    expr: AstNodeIndex;

    pub fn new(expr: AstNodeIndex) ExprStmt {
        var self: ExprStmt = undefined;
        self.type = AstNodeType::ExprStmt;
        self.pad = 0 as u16;
        self.expr = expr;
        return self;
    }

    pub fn fmt(self: *const ExprStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        ast.display_node(fmt, self.expr._private_index, indent);
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct ReturnStmt {
    type: AstNodeType;
    pad: u8;
    is_err: bool;
    expr: OptionalAstNodeIndex;

    pub fn new(is_err: bool, expr: OptionalAstNodeIndex) ReturnStmt {
        var self: ReturnStmt = undefined;
        self.type = AstNodeType::ReturnStmt;
        self.pad = 0 as u8;
        self.is_err = is_err;
        self.expr = expr;
        return self;
    }

    pub fn fmt(self: *const ReturnStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr(self.is_err ? "ereturn" as *const u8 : "return" as *const u8);
        if (self.expr.is_some()) {
            fmt.unsafe_cstr_ptr(" ");
            ast.display_node(fmt, self.expr._private_index, indent);
        }
        fmt.unsafe_cstr_ptr(";");
    }
}

pub struct BreakStmt {
    type: AstNodeType;
    pad: u16;

    pub fn new() BreakStmt {
        var self: BreakStmt = undefined;
        self.type = AstNodeType::BreakStmt;
        self.pad = 0 as u16;
        return self;
    }

    pub fn fmt(self: *const BreakStmt, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("break;");
    }
}

pub struct ContinueStmt {
    type: AstNodeType;
    pad: u16;

    pub fn new() ContinueStmt {
        var self: ContinueStmt = undefined;
        self.type = AstNodeType::ContinueStmt;
        self.pad = 0 as u16;
        return self;
    }

    pub fn fmt(self: *const ContinueStmt, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("continue;");
    }
}

pub struct IfStmt {
    type: AstNodeType;
    pad: u16;
    cond: AstNodeIndex;
    then_branch: AstNodeIndex;
    else_branch: OptionalAstNodeIndex;

    pub fn new(cond: AstNodeIndex, then_branch: AstNodeIndex, else_branch: OptionalAstNodeIndex) IfStmt {
        var self: IfStmt = undefined;
        self.type = AstNodeType::IfStmt;
        self.pad = 0 as u16;
        self.cond = cond;
        self.then_branch = then_branch;
        self.else_branch = else_branch;
        return self;
    }

    pub fn fmt(self: *const IfStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("if (");
        ast.display_node(fmt, self.cond._private_index, indent);
        fmt.unsafe_cstr_ptr(")");

        fmt_if_branches(fmt, self.then_branch, self.else_branch, ast, indent);
    }
}

pub struct WhileStmt {
    type: AstNodeType;
    cond: AstNodeIndex;
    body: AstNodeIndex;
    loop_stmt: OptionalAstNodeIndex;

    pub fn new(cond: AstNodeIndex, body: AstNodeIndex, loop_stmt: OptionalAstNodeIndex) WhileStmt {
        var self: WhileStmt = undefined;
        self.type = AstNodeType::WhileStmt;
        self.cond = cond;
        self.body = body;
        self.loop_stmt = loop_stmt;
        return self;
    }

    pub fn fmt(self: *const WhileStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("while (");
        ast.display_node(fmt, self.cond._private_index, indent);
        fmt.unsafe_cstr_ptr(")");

        var sub_stmt_indent: u64 = undefined;
        const body_is_block = stmt_is_type(ast, self.body._private_index, AstNodeType::BlockStmt);
        if (body_is_block) {
            sub_stmt_indent = indent;
            fmt.unsafe_cstr_ptr(" ");
        } else {
            sub_stmt_indent = indent + 1 as u8;
            fmt.newline();
            Ast::fmt_indent(fmt, sub_stmt_indent);
        }
        ast.display_node(fmt, self.body._private_index, sub_stmt_indent);

        if (self.loop_stmt.is_some()) {
            if (body_is_block) {
                fmt.unsafe_cstr_ptr(" loop ");
            } else {
                fmt.newline();
                Ast::fmt_indent(fmt, indent);
                fmt.unsafe_cstr_ptr("loop ");
            }
            ast.display_node(fmt, self.loop_stmt._private_index, indent);
        }
    }
}

pub struct ForStmt {
    type: AstNodeType;
    expr_count: u8; // 2 means only end_expr and start_expr
    binding_count: u8; // 1 means only inc binding
    exprs: AstExtraIndex; // list of AstNode (start_expr, end_expr, ..ptr_expr)
    bindings: AstExtraIndex; // list of Identifier (incr, ..ptr_binding)
    body: AstNodeIndex;

    pub fn new(
        expr_count: u8,
        binding_count: u8,
        exprs: AstExtraIndex,
        bindings: AstExtraIndex,
        body: AstNodeIndex,
    ) ForStmt {
        var self: ForStmt = undefined;
        self.type = AstNodeType::ForStmt;
        self.expr_count = expr_count;
        self.binding_count = binding_count;
        self.exprs = exprs;
        self.bindings = bindings;
        self.body = body;
        return self;
    }

    pub fn fmt(self: *const ForStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("for (");
        const first_expr_ptr = &ast.extra.items[self.exprs._private_index];
        ast.display_node(fmt, first_expr_ptr[0], indent);
        fmt.unsafe_cstr_ptr(".. ");
        ast.display_node(fmt, first_expr_ptr[1], indent);
        for (2..self.expr_count, &first_expr_ptr[2]) |_, expr| {
            fmt.unsafe_cstr_ptr(", ");
            ast.display_node(fmt, expr.*, indent);
        }
        fmt.unsafe_cstr_ptr(") |");

        const first_binding = &ast.extra.items[self.bindings._private_index] as *Identifier;
        first_binding.fmt(fmt, ast);
        for (1..self.binding_count, &first_binding[1]) |_, binding| {
            fmt.unsafe_cstr_ptr(", ");
            fmt.slice(ast.interner.get(binding.sym));
        }
        fmt.unsafe_cstr_ptr("|");

        var sub_stmt_indent: u64 = undefined;
        if (stmt_is_type(ast, self.body._private_index, AstNodeType::BlockStmt)) {
            sub_stmt_indent = indent;
            fmt.unsafe_cstr_ptr(" ");
        } else {
            sub_stmt_indent = indent + 1 as u8;
            fmt.newline();
            Ast::fmt_indent(fmt, sub_stmt_indent);
        }
        ast.display_node(fmt, self.body._private_index, sub_stmt_indent);
    }
}

pub struct BlockStmt {
    type: AstNodeType;
    pad: u16;
    stmt_count: u32;
    stmts: AstExtraIndex; // list of AstNodeIndex (stmt)

    pub fn new(stmt_count: u32, stmts: AstExtraIndex) BlockStmt {
        var self: BlockStmt = undefined;
        self.type = AstNodeType::BlockStmt;
        self.pad = 0 as u16;
        self.stmt_count = stmt_count;
        self.stmts = stmts;
        return self;
    }

    pub fn fmt(self: *const BlockStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("{");
        if (self.stmt_count != 0) {
            fmt.newline();
            const sub_stmt_indent = indent + 1 as u8;
            for (0..self.stmt_count, &ast.extra.items[self.stmts._private_index]) |_, stmt| {
                Ast::fmt_indent(fmt, sub_stmt_indent);
                ast.display_node(fmt, stmt.*, sub_stmt_indent);
                fmt.newline();
            }
            Ast::fmt_indent(fmt, indent);
        }
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct SwitchStmt {
    type: AstNodeType;
    branch_count: u16;
    cond: AstNodeIndex;
    branches: AstExtraIndex; // list of AstNodes (SwitchBranchStmts)
    then_branch: OptionalAstNodeIndex; // AstNode (stmt)
    else_branch: OptionalAstNodeIndex; // AstNode (stmt)

    pub fn new(
        branch_count: u16,
        cond: AstNodeIndex,
        branches: AstExtraIndex,
        then_branch: OptionalAstNodeIndex,
        else_branch: OptionalAstNodeIndex,
    ) SwitchStmt {
        var self: SwitchStmt = undefined;
        self.type = AstNodeType::SwitchStmt;
        self.branch_count = branch_count;
        self.cond = cond;
        self.branches = branches;
        self.then_branch = then_branch;
        self.else_branch = else_branch;
        return self;
    }

    pub fn fmt(self: *const SwitchStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("switch (");
        ast.display_node(fmt, self.cond._private_index, indent);
        fmt.unsafe_cstr_ptr(") {");
        const branch_indent = indent + 1 as u8;
        if (self.branch_count > 0) {
            for (0..self.branch_count, &ast.extra.items[self.branches._private_index]) |_, branch| {
                fmt.newline();
                Ast::fmt_indent(fmt, branch_indent);
                ast.display_node(fmt, branch.*, branch_indent);
            }
        }
        if (self.then_branch.is_some()) {
            fmt.newline();
            Ast::fmt_indent(fmt, branch_indent);
            fmt.unsafe_cstr_ptr("then => ");
            ast.display_node(fmt, self.then_branch._private_index, branch_indent);
        }
        if (self.else_branch.is_some()) {
            fmt.newline();
            Ast::fmt_indent(fmt, branch_indent);
            fmt.unsafe_cstr_ptr("else => ");
            ast.display_node(fmt, self.else_branch._private_index, branch_indent);
        }
        fmt.newline();
        Ast::fmt_indent(fmt, indent);
        fmt.unsafe_cstr_ptr("}");
    }
}

pub struct SwitchBranchStmt {
    type: AstNodeType;
    literal_expr_count: u16; // atleast one
    literal_exprs: AstExtraIndex; // AstNode (exprs/literals)
    body: AstNodeIndex;

    pub fn new(literal_expr_count: u16, literal_exprs: AstExtraIndex, body: AstNodeIndex) SwitchBranchStmt {
        var self: SwitchBranchStmt = undefined;
        self.type = AstNodeType::SwitchBranchStmt;
        self.literal_expr_count = literal_expr_count;
        self.literal_exprs = literal_exprs;
        self.body = body;
        return self;
    }

    pub fn fmt(self: *const SwitchBranchStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        const first_literal_expr = &ast.extra.items[self.literal_exprs._private_index];
        ast.display_node(fmt, first_literal_expr.*, indent);
        for (1..self.literal_expr_count, &first_literal_expr[1]) |_, literal_expr| {
            fmt.newline();
            Ast::fmt_indent(fmt, indent);
            fmt.unsafe_cstr_ptr("| ");
            ast.display_node(fmt, literal_expr.*, indent);
        }
        fmt.unsafe_cstr_ptr(" => ");
        ast.display_node(fmt, self.body._private_index, indent);
    }
}

pub struct CompifStmt {
    type: AstNodeType;
    pad: u8;
    is_check_inverted: bool;
    cond_expr: AstNodeIndex;
    cond_match_type: OptionalAstNodeIndex;
    then_branch: AstNodeIndex;
    else_branch: OptionalAstNodeIndex;

    pub fn new(
        is_check_inverted: bool,
        cond_expr: AstNodeIndex,
        cond_match_type: OptionalAstNodeIndex,
        then_branch: AstNodeIndex,
        else_branch: OptionalAstNodeIndex,
    ) CompifStmt {
        var self: CompifStmt = undefined;
        self.type = AstNodeType::CompifStmt;
        self.pad = 0 as u8;
        self.is_check_inverted = is_check_inverted;
        self.cond_expr = cond_expr;
        self.cond_match_type = cond_match_type;
        self.then_branch = then_branch;
        self.else_branch = else_branch;
        return self;
    }

    pub fn fmt(self: *const CompifStmt, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        fmt.unsafe_cstr_ptr("compif (");
        ast.display_node(fmt, self.cond_expr._private_index, indent);
        if (self.cond_match_type.is_some()) {
            fmt.unsafe_cstr_ptr(self.is_check_inverted ? ": !" as *const u8 : ": " as *const u8);
            ast.display_node(fmt, self.cond_match_type._private_index, indent);
        }
        fmt.unsafe_cstr_ptr(")");

        fmt_if_branches(fmt, self.then_branch, self.else_branch, ast, indent);
    }
}

pub fn fmt_if_branches(
    fmt: *Formatter,
    then_branch: AstNodeIndex,
    else_branch: OptionalAstNodeIndex,
    ast: *const Ast,
    indent: u64
) void {
    var sub_stmt_indent: u64 = undefined;
    const then_branch_is_block = stmt_is_type(ast, then_branch._private_index, AstNodeType::BlockStmt);
    if (then_branch_is_block) {
        sub_stmt_indent = indent;
        fmt.unsafe_cstr_ptr(" ");
    } else {
        sub_stmt_indent = indent + 1 as u8;
        fmt.newline();
        Ast::fmt_indent(fmt, sub_stmt_indent);
    }
    ast.display_node(fmt, then_branch._private_index, sub_stmt_indent);

    if (else_branch.is_some()) {
        if (then_branch_is_block) {
            fmt.unsafe_cstr_ptr(" else");
        } else {
            fmt.newline();
            Ast::fmt_indent(fmt, indent);
            fmt.unsafe_cstr_ptr("else");
        }

        if (
            stmt_is_type(ast, else_branch._private_index, AstNodeType::BlockStmt)
            or stmt_is_type(ast, else_branch._private_index, AstNodeType::IfStmt)
            or stmt_is_type(ast, else_branch._private_index, AstNodeType::CompifStmt)
        ) {
            sub_stmt_indent = indent;
            fmt.unsafe_cstr_ptr(" ");
        } else {
            sub_stmt_indent = indent + 1 as u8;
            fmt.newline();
            Ast::fmt_indent(fmt, sub_stmt_indent);
        }
        ast.display_node(fmt, else_branch._private_index, sub_stmt_indent);
    }
}

pub enum AssignOp {
    Equal,
    BitOr,
    BitXor,
    BitAnd,
    ShiftR,
    ShiftL,
    TermAdd,
    TermSub,
    FactorMul,
    FactorDiv,
    FactorMod,
}