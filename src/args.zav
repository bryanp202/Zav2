use ::std::slice::Slice;
use ::std::str::CStr;
use ::std::option::Option;
use ::std::mem;

pub fn display_help() void {
    var fmt = ::std::fmt::Formatter::new();
    fmt.unsafe_cstr_ptr("Usage: Zav [options] <source_file>\n");
    fmt.newline();
    fmt.unsafe_cstr_ptr("Options:\n");
    fmt.unsafe_cstr_ptr("  --stage                Toggle which stage to stop terminate compilation\n");
    fmt.unsafe_cstr_ptr("         =lexing              Stop after tokenizing source files\n");
    fmt.unsafe_cstr_ptr("         =parsing             Stop after parsing source files to ast\n");
    fmt.unsafe_cstr_ptr("         =semantic            Stop after name-resolution and type checking\n");
    fmt.unsafe_cstr_ptr("         =assembling          Stop after assembling\n");
    fmt.unsafe_cstr_ptr("         =linking             Stop after linking to an executable\n");
    fmt.unsafe_cstr_ptr("  -s, --emit-asm          Emit assembly files for each module\n");
    fmt.unsafe_cstr_ptr("  -d, --show-ast          Display Abstract Syntax Tree (AST) during compilation\n");
    fmt.unsafe_cstr_ptr("  -o <file>               Specify output file name (default is 'out.exe')\n");
    fmt.unsafe_cstr_ptr("  -h, --help              Display this help message\n");
    fmt.newline();
    fmt.unsafe_cstr_ptr("Example:\n");
    fmt.unsafe_cstr_ptr("  Zav -s -o splicer.exe ./src/main.zav    # Output assembly and specify output file 'splicer.exe'\n");
    fmt.unsafe_cstr_ptr("  Zav -d splicer.zav                      # Display the AST for each module and compile to default 'out.exe'\n");
    fmt.newline();
    fmt.print();
}

pub struct CompileSettings {
    call_path: CStr;
    root_path: CStr;
    output_path: CStr;
    until_stage: Stage;
    display_help: bool;

    pub fn debug(self: *const CompileSettings) void {
        var fmt = ::std::fmt::Formatter::new();
        fmt.unsafe_cstr_ptr("-----------------------------------------\n");
        fmt.unsafe_cstr_ptr("CompileSettings:\n");
        fmt.unsafe_cstr_ptr("call_path: ");
        fmt.cstr(self.call_path);
        fmt.newline();
        fmt.unsafe_cstr_ptr("root_path: ");
        fmt.cstr(self.root_path);
        fmt.newline();
        fmt.unsafe_cstr_ptr("output_path: ");
        fmt.cstr(self.output_path);
        fmt.newline();
        fmt.unsafe_cstr_ptr("until_stage: ");
        fmt.uint(self.until_stage as u64);
        fmt.newline();
        fmt.unsafe_cstr_ptr("display_help: ");
        fmt.boolean(self.display_help);
        fmt.newline();
        fmt.unsafe_cstr_ptr("-----------------------------------------\n");
        fmt.print();
    }
}

pub enum Stage {
    None,
    Lexing,
    Parsing,
    Semantic,
    Assembling,
    Linking
}

pub struct ArgsParser {
    args: Slice[*const u8];

    pub fn new(argc: i64, argv: *const *const u8) ArgsParser {
        var self: ArgsParser = undefined;
        self.args = Slice::[*const u8]::new(argv, argc as u64);
        return self;
    }

    pub fn parse(self: *ArgsParser) CompileSettings {
        var settings: CompileSettings = undefined;
        settings.call_path = CStr::unsafe_from_ptr(self.args.ptr[0]);
        settings.root_path = CStr::unsafe_from_ptr(nullptr);
        settings.output_path = CStr::unsafe_from_ptr(nullptr);
        settings.until_stage = Stage::None;
        settings.display_help = false;

        var i = 1;
        while (i < self.args.len) {
            const arg = self.args.ptr[i];
            switch (arg[0]) {
                '-' => {
                    if (arg[1] == '-') {
                        i += parse_long_arg(&settings, &self.args, i);
                    } else {
                        i += parse_short_arg(&settings, &self.args, i);
                    }
                }
                else => i += parse_root_path_arg(&settings, &self.args, i);
            }
        }
        
        if (settings.until_stage == Stage::None) {
            settings.until_stage = Stage::Linking;
        }

        // Check if it settings in valid state
        if (settings.root_path.ptr == nullptr) {
            settings.display_help = true;
        }

        return settings;
    }
}

fn parse_root_path_arg(settings: *CompileSettings, args: *const Slice[*const u8], i: i64) i64 {
    if (settings.root_path.ptr == nullptr) {
        const root_path = args.ptr[i];
        settings.root_path = CStr::unsafe_from_ptr(root_path);
        return 1;
    }

    settings.display_help = true;
    return 1;
}

// arg that starts with "--"
fn parse_long_arg(settings: *CompileSettings, args: *const Slice[*const u8], i: i64) i64 {
    const arg = args.ptr[i];
    switch (arg[2]) {
        's' => {
            const match = "stage=";
            if (mem::eql::[u8](@len(match.*), match, &arg[2])) {
                const stage = parse_stage(&arg[2 + @len(match.*)]);
                if (stage.is_some() and settings.until_stage == Stage::None) {
                    settings.until_stage = stage.unwrap();
                    return 1;
                }
            }
        }
    }

    settings.display_help = true;
    return 1;
}

// arg that starts with '-'
fn parse_short_arg(settings: *CompileSettings, args: *const Slice[*const u8], i: i64) i64 {
    const arg = args.ptr[i];
    switch (arg[1]) {
        'o' => {
            if (
                i + 1 < args.len
                and settings.output_path.ptr == nullptr
                and args.ptr[i + 1][0] != '-'
            ) {
                const output_path = args.ptr[i + 1];
                settings.output_path = CStr::unsafe_from_ptr(output_path);
                return 2;
            }
        }
    }

    settings.display_help = true;
    return 1;
}

fn parse_stage(arg: *const u8) Option[Stage] {
    const cstr_arg = CStr::unsafe_from_ptr(arg);
    switch (arg[0]) {
        'l' => switch (arg[1]) {
            'e' => if (cstr_arg.unsafe_eql_ptr("lexing")) return Option::[Stage]::Some(Stage::Lexing);
            'i' => if (cstr_arg.unsafe_eql_ptr("linking")) return Option::[Stage]::Some(Stage::Linking);
        }
        'p' => if (cstr_arg.unsafe_eql_ptr("parsing")) return Option::[Stage]::Some(Stage::Parsing);
        's' => if (cstr_arg.unsafe_eql_ptr("semantic")) return Option::[Stage]::Some(Stage::Semantic);
        'a' => if (cstr_arg.unsafe_eql_ptr("assembling")) return Option::[Stage]::Some(Stage::Assembling);
        
    }

    return Option::[Stage]::None();
}