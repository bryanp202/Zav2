use ::std::slice::Slice;
use ::std::path::PathBuf;
use ::std::fmt::Formatter;
use ::std::collections::list::List;

use symbol::Symbol;

pub struct UnresolvedModule {
    path: PathBuf;
    canonical_name: Symbol;
    ast: Ast;

    pub fn new(path: PathBuf, canonical_name: Symbol, ast: Ast) UnresolvedModule {
        var self: UnresolvedModule = undefined;
        self.path = path;
        self.canonical_name = canonical_name;
        self.ast = ast;
        return self;
    }

    pub fn free(self: *const UnresolvedModule) void {
        self.path.free();
        self.ast.free();
    }
}

pub struct Ast {
    nodes: List[u32];
    extra: List[u32];
    spans: List[Span];

    pub fn new() Ast {
        var self: Ast = undefined;
        self.nodes = List::[u32]::new();
        self.extra = List::[u32]::new();
        self.spans = List::[Span]::new();
        return self;
    }

    pub fn free(self: *const Ast) void {
        self.nodes.free();
        self.extra.free();
        self.spans.free();
    }

    pub fn fmt(self: *const Ast, fmt: *Formatter) void {
        if (self.nodes.is_empty()) {
            fmt.unsafe_cstr_ptr("[empty]");
            return;
        }
        self.display_node(fmt, 0 as u8);
    }

    pub fn display_next_node(self: *const Ast, fmt: *Formatter, index: u64, size: u64) void {
        self.display_node(fmt, index + size / 4 as u8);
    } 

    pub fn display_node(self: *const Ast, fmt: *Formatter, index: u64) void {
        const node = &self.nodes.items[index];
        const type = node.* as AstNodeType;
        switch (type) {
            AstNodeType::VoidType => fmt.unsafe_cstr_ptr("void");
            AstNodeType::BoolType => fmt.unsafe_cstr_ptr("bool");
            AstNodeType::IntType => (node as *ty::IntType).fmt(fmt);
            AstNodeType::UintType => (node as *ty::UintType).fmt(fmt);
            AstNodeType::FloatType => (node as *ty::FloatType).fmt(fmt);
            AstNodeType::PtrType => (node as *ty::PtrType).fmt(fmt, self, index);
            AstNodeType::ArrayType => (node as *ty::ArrayType).fmt(fmt, self, index);
            AstNodeType::FnType => (node as *ty::FnType).fmt(fmt, self);
            AstNodeType::TupleType => (node as *ty::TupleType).fmt(fmt, self);
            else => @abort("unsupported node type: %llu\n", type);
        }
    }
}

pub struct Span {
    start: u32;
    len: u32;

    pub fn new(start: u32, len: u32) Span {
        var self: Span = undefined;
        self.start = start;
        self.len = len;
        return self;
    }

    pub fn eql(self: *const Span, other: *const Span) bool {
        return self.start == other.start and self.len == other.len;
    }

    pub fn fmt(self: *const Span, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("[");
        fmt.uint(self.start);
        fmt.unsafe_cstr_ptr("..");
        fmt.uint(self.start + self.len);
        fmt.unsafe_cstr_ptr("]");
    }
}

pub struct AstNodeIndex {
    _private_index: u32;

    overload== (self: AstNodeIndex, other: AstNodeIndex) bool {
        return self._private_index == other._private_index;
    }
}

/// 4294967295 is null
pub struct OptionalAstNodeIndex {
    _private_index: u32;

    fn is_some(self: *const OptionalAstNodeIndex) bool {
        return self._private_index == 4294967295;
    }

    overload== (self: OptionalAstNodeIndex, other: OptionalAstNodeIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct SpanIndex {
    _private_index: u32;

    overload== (self: SpanIndex, other: SpanIndex) bool {
        return self._private_index == other._private_index;
    }
}

/// 4294967295 is null
pub struct OptionalSpanIndex {
    _private_index: u32;

    fn is_some(self: *const OptionalSpanIndex) bool {
        return self._private_index == 4294967295;
    }

    overload== (self: OptionalSpanIndex, other: OptionalSpanIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct AstExtraIndex {
    _private_index: u32;

    overload== (self: AstExtraIndex, other: AstExtraIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct Identifier {
    sym: Symbol;
    span: SpanIndex;
}

pub struct Parameter {
    pattern: AstNodeIndex;
    ty: AstNodeIndex;
}

pub struct IdentNode {
    type: AstNodeType;
    generic_count: u8;
    sym: Symbol;
    span: SpanIndex;
    generics: AstExtraIndex; // AstNodeIndex (types)
}

// degrades into a "null" terminated list if no generics
pub struct ScopeNode {
    type: AstNodeIndex;
    absolute: bool;
    generic_count: u8;
    ident_sym: Symbol;
    ident_span: SpanIndex;
    // next: AstNodeIndex (always +1);
}

pub struct AstPoison {
    type: AstNodeType;
    span: SpanIndex;

    pub fn new(span: SpanIndex) AstPoison {
        var self: AstPoison = undefined;
        self.type = AstNodeType::Poison;
        self.span = span;
        return self;
    }
}

pub enum AstNodeType {
    /* item */
    DeclItem,
    ModuleItem,
    FnItem,
    StructItem,
    UnionItem,
    EnumItem,
    UseItem,
    /* use tree */
    UseTreeNode,
    UseTreeBranch,
    UseTreeLeaf,

    /* stmt: maybe all expr at somepoint */
    // special stmt
    ItemStmt,
    DeferStmt,
    DeclStmt,
    // other stmt
    AssignStmt,
    ExprStmt,
    ReturnStmt,
    BreakStmt,
    ContinueStmt,
    IfStmt,
    WhileStmt,
    ForStmt,
    BlockStmt,
    StmtSwitch,

    /* expr */
    TernaryExpr,
    BinaryExpr,
    Conversion,
    UnaryExpr,
    CallExpr,
    NativeExpr,
    LambdaExpr,
    ArrayExpr,
    StructExpr,
    TupleExpr,
    IdentExpr,
    ScopeExpr,
    PrimativeExpr,

    /* types */
    VoidType,
    BoolType,
    UintType,
    IntType,
    FloatType,
    PtrType,
    ArrayType,
    FnType,
    TupleType,
    IdentType,
    ScopedIdentType,

    /* patterns */
    PatternDestruct,
    PatternTuple,
    PatternIdent,

    /* shared */
    ScopedIdentifier,
    ScopeSegment,
    Identifier,
    Poison,
}