pub mod error;
pub mod lexer;
pub mod parser;
pub mod symbol;
pub mod expr;
pub mod stmt;
pub mod item;
pub mod pattern;
pub mod ty;

use ::std::slice::Slice;
use ::std::path::PathBuf;
use ::std::fmt::Formatter;
use ::std::collections::list::List;

use symbol::Symbol;
use symbol::SymbolInterner;

pub struct UnresolvedModule {
    path: PathBuf;
    canonical_name: Symbol;
    ast: Ast;

    pub fn new(path: PathBuf, canonical_name: Symbol, ast: Ast) UnresolvedModule {
        var self: UnresolvedModule = undefined;
        self.path = path;
        self.canonical_name = canonical_name;
        self.ast = ast;
        return self;
    }

    pub fn free(self: *const UnresolvedModule) void {
        self.path.free();
        self.ast.free();
    }
}

pub struct Ast {
    interner: SymbolInterner;
    nodes: List[u32];
    extra: List[u32];
    spans: List[Span];

    pub fn new(interner: SymbolInterner) Ast {
        var self: Ast = undefined;
        self.interner = interner;
        self.nodes = List::[u32]::new();
        self.extra = List::[u32]::new();
        self.spans = List::[Span]::new();
        return self;
    }

    pub fn free(self: *const Ast) void {
        self.nodes.free();
        self.extra.free();
        self.spans.free();
    }

    pub fn fmt(self: *const Ast, fmt: *Formatter) void {
        const root_node = &self.nodes.items[0] as *RootNode;
        root_node.fmt(fmt, self);
    }

    pub fn fmt_indent(fmt: *Formatter, indent: u64) void {
        for (0..indent) |_| {
            fmt.unsafe_cstr_ptr("    ");
        }
    }

    pub fn display_next_node(self: *const Ast, fmt: *Formatter, index: u64, size: u64, indent: u64) void {
        self.display_node(fmt, index + size / 4 as u8, indent);
    } 

    pub fn display_node(self: *const Ast, fmt: *Formatter, index: u64, indent: u64) void {
        const node = &self.nodes.items[index];
        const type = node.* as AstNodeType;
        switch (type) {
            // type
            AstNodeType::VoidType => (node as *ty::VoidType).fmt(fmt);
            AstNodeType::BoolType => (node as *ty::BoolType).fmt(fmt);
            AstNodeType::IntType => (node as *ty::IntType).fmt(fmt);
            AstNodeType::UintType => (node as *ty::UintType).fmt(fmt);
            AstNodeType::FloatType => (node as *ty::FloatType).fmt(fmt);
            AstNodeType::PtrType => (node as *ty::PtrType).fmt(fmt, self, index, indent);
            AstNodeType::ArrayType => (node as *ty::ArrayType).fmt(fmt, self, indent);
            AstNodeType::FnType => (node as *ty::FnType).fmt(fmt, self, indent);
            AstNodeType::TupleType => (node as *ty::TupleType).fmt(fmt, self, indent);
            AstNodeType::IdentType => (node as *ty::IdentType).fmt(fmt, self);
            AstNodeType::GenericType => (node as *ty::GenericType).fmt(fmt, self, indent);
            AstNodeType::ScopedType => (node as *ty::ScopedType).fmt(fmt, self, indent);
            // pattern
            AstNodeType::IdentPattern => (node as *pattern::IdentPattern).fmt(fmt, self);
            AstNodeType::DestructPattern => (node as *pattern::DestructPattern).fmt(fmt, self, indent);
            AstNodeType::ArrayPattern => (node as *pattern::ArrayPattern).fmt(fmt, self, indent);
            AstNodeType::TuplePattern => (node as *pattern::TuplePattern).fmt(fmt, self, indent);
            // expr
            AstNodeType::IfExpr => (node as *expr::IfExpr).fmt(fmt, self, indent);
            AstNodeType::BinaryExpr => (node as *expr::BinaryExpr).fmt(fmt, self, indent);
            AstNodeType::UnaryExpr => (node as *expr::UnaryExpr).fmt(fmt, self, indent);
            AstNodeType::TrailingExpr => (node as *expr::TrailingExpr).fmt(fmt, self, indent);
            AstNodeType::TupleIndexExpr => (node as *expr::TupleIndexExpr).fmt(fmt, self, indent);
            AstNodeType::CallExpr => (node as *expr::CallExpr).fmt(fmt, self, indent);
            AstNodeType::NativeExpr => (node as *expr::NativeExpr).fmt(fmt, self, indent);
            AstNodeType::LambdaExpr => (node as *expr::LambdaExpr).fmt(fmt, self, indent);
            AstNodeType::ArrayExpr => (node as *expr::ArrayExpr).fmt(fmt, self, index, indent);
            AstNodeType::StructExpr => (node as *expr::StructExpr).fmt(fmt, self, indent);
            AstNodeType::TupleExpr => (node as *expr::TupleExpr).fmt(fmt, self, indent);
            AstNodeType::PrimativeExpr => (node as *expr::PrimativeExpr).fmt(fmt, self);
            AstNodeType::IdentExpr => (node as *expr::IdentExpr).fmt(fmt, self);
            AstNodeType::GenericExpr => (node as *expr::GenericExpr).fmt(fmt, self, indent);
            AstNodeType::ScopedExpr => (node as *expr::ScopedExpr).fmt(fmt, self, indent);
            // stmt
            AstNodeType::ItemStmt => (node as *stmt::ItemStmt).fmt(fmt, self, index, indent);
            AstNodeType::DeferStmt => (node as *stmt::DeferStmt).fmt(fmt, self, indent);
            AstNodeType::DeclStmt => (node as *stmt::DeclStmt).fmt(fmt, self, index, indent);
            AstNodeType::AssignStmt => (node as *stmt::AssignStmt).fmt(fmt, self, indent);
            AstNodeType::ExprStmt => (node as *stmt::ExprStmt).fmt(fmt, self, indent);
            AstNodeType::ReturnStmt => (node as *stmt::ReturnStmt).fmt(fmt, self, indent);
            AstNodeType::BreakStmt => (node as *stmt::BreakStmt).fmt(fmt);
            AstNodeType::ContinueStmt => (node as *stmt::ContinueStmt).fmt(fmt);
            AstNodeType::IfStmt => (node as *stmt::IfStmt).fmt(fmt, self, indent);
            AstNodeType::WhileStmt => (node as *stmt::WhileStmt).fmt(fmt, self, indent);
            AstNodeType::ForStmt => (node as *stmt::ForStmt).fmt(fmt, self, indent);
            AstNodeType::BlockStmt => (node as *stmt::BlockStmt).fmt(fmt, self, indent);
            AstNodeType::SwitchStmt => (node as *stmt::SwitchStmt).fmt(fmt, self, indent);
            AstNodeType::SwitchBranchStmt => (node as *stmt::SwitchBranchStmt).fmt(fmt, self, indent);
            // item
            AstNodeType::DeclItem => (node as *item::DeclItem).fmt(fmt, self, indent);
            AstNodeType::ModuleItem => (node as *item::ModuleItem).fmt(fmt, self);
            AstNodeType::FnItem => (node as *item::FnItem).fmt(fmt, self, indent);
            AstNodeType::StructItem => (node as *item::StructItem).fmt(fmt, self, indent);
            AstNodeType::UnionItem => (node as *item::UnionItem).fmt(fmt, self, indent);
            AstNodeType::EnumItem => (node as *item::EnumItem).fmt(fmt, self, indent);
            AstNodeType::UseItem => (node as *item::UseItem).fmt(fmt, self, index, indent);
            /* sub items */
            AstNodeType::StructureField => (node as *item::StructureField).fmt(fmt, self, indent);
            AstNodeType::UseTree => (node as *item::UseTree).fmt(fmt, self, index, indent);
            AstNodeType::UseTreeSimple => (node as *item::UseTreeSimple).fmt(fmt, self);
            AstNodeType::UseTreeNested => (node as *item::UseTreeNested).fmt(fmt, self, indent);
            // other
            AstNodeType::Poison => (node as *AstPoison).fmt(fmt);
            else => @abort("unsupported node type: %llu\n", type);
        }
    }
}

pub struct Span {
    start: u32;
    len: u32;

    pub fn new(start: u32, len: u32) Span {
        var self: Span = undefined;
        self.start = start;
        self.len = len;
        return self;
    }

    pub fn eql(self: *const Span, other: *const Span) bool {
        return self.start == other.start and self.len == other.len;
    }

    pub fn fmt(self: *const Span, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("[");
        fmt.uint(self.start);
        fmt.unsafe_cstr_ptr("..");
        fmt.uint(self.start + self.len);
        fmt.unsafe_cstr_ptr("]");
    }
}

pub struct AstNodeIndex {
    _private_index: u32;

    pub fn as_optional(self: *const AstNodeIndex) OptionalAstNodeIndex {
        var optional: OptionalAstNodeIndex = undefined;
        optional._private_index = self._private_index;
        return optional;
    }

    overload== (self: AstNodeIndex, other: AstNodeIndex) bool {
        return self._private_index == other._private_index;
    }
}

/// 4294967295 is null
pub struct OptionalAstNodeIndex {
    _private_index: u32;

    pub fn None() OptionalAstNodeIndex {
        var self: OptionalAstNodeIndex = undefined;
        self._private_index = 4294967295 as u32;
        return self;
    }

    pub fn is_some(self: *const OptionalAstNodeIndex) bool {
        return self._private_index != 4294967295 as u32;
    }

    pub fn unwrap(self: *const OptionalAstNodeIndex) AstNodeIndex {
        var index: AstNodeIndex = undefined;
        index._private_index = self._private_index;
        return index;
    }

    overload== (self: OptionalAstNodeIndex, other: OptionalAstNodeIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct SpanIndex {
    _private_index: u32;

    overload== (self: SpanIndex, other: SpanIndex) bool {
        return self._private_index == other._private_index;
    }
}

/// 4294967295 is null
pub struct OptionalSpanIndex {
    _private_index: u32;

    pub fn is_some(self: *const OptionalSpanIndex) bool {
        return self._private_index != 4294967295;
    }

    overload== (self: OptionalSpanIndex, other: OptionalSpanIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct AstExtraIndex {
    _private_index: u32;

    overload== (self: AstExtraIndex, other: AstExtraIndex) bool {
        return self._private_index == other._private_index;
    }
}

pub struct RootNode {
    type: AstNodeType;
    start: OptionalAstNodeIndex;

    pub fn new(start: OptionalAstNodeIndex) RootNode {
        var self: RootNode = undefined;
        self.type = AstNodeType::Root;
        self.start = start;
        return self;
    }

    pub fn fmt(self: *const RootNode, fmt: *Formatter, ast: *const Ast) void {
        if (self.start.is_some()) {
            ast.display_node(fmt, self.start._private_index, 0 as u64);
        } else {
            fmt.unsafe_cstr_ptr("[empty]");
        }
    }
}

pub struct Identifier {
    span: SpanIndex;
    sym: Symbol;

    pub fn new(span: SpanIndex, sym: Symbol) Identifier {
        var self: Identifier = undefined;
        self.span = span;
        self.sym = sym;
        return self;
    }

    pub fn fmt(self: *const Identifier, fmt: *Formatter, ast: *const Ast) void {
        fmt.slice(ast.interner.get(self.sym));
    }
}

pub struct Parameter {
    pattern: AstNodeIndex;
    ty: AstNodeIndex;

    pub fn new(pattern: AstNodeIndex, ty: AstNodeIndex) Parameter {
        var self: Parameter = undefined;
        self.pattern = pattern;
        self.ty = ty;
        return self;
    }

    pub fn fmt(self: *const Parameter, fmt: *Formatter, ast: *const Ast, indent: u64) void {
        ast.display_node(fmt, self.pattern._private_index, indent);
        fmt.unsafe_cstr_ptr(": ");
         ast.display_node(fmt, self.ty._private_index, indent);
    }
}

pub struct AstPoison {
    type: AstNodeType;
    span: SpanIndex;

    pub fn new(span: SpanIndex) AstPoison {
        var self: AstPoison = undefined;
        self.type = AstNodeType::Poison;
        self.span = span;
        return self;
    }

    pub fn fmt(self: *const AstPoison, fmt: *Formatter) void {
        fmt.unsafe_cstr_ptr("#poison#");
    }
}

pub enum AstNodeType {
    Root,
    /* item */
    DeclItem,
    ModuleItem,
    FnItem,
    StructItem,
    UnionItem,
    EnumItem,
    UseItem,
    /* sub items */
    StructureField,
    UseTree,
    UseTreeSimple,
    UseTreeNested,

    /* stmt: maybe all expr at somepoint */
    // special stmt
    ItemStmt,
    DeferStmt,
    DeclStmt,
    // other stmt
    AssignStmt,
    ExprStmt,
    ReturnStmt,
    BreakStmt,
    ContinueStmt,
    IfStmt,
    WhileStmt,
    ForStmt,
    BlockStmt,
    SwitchStmt,
    SwitchBranchStmt,

    /* expr */
    IfExpr,
    BinaryExpr,
    UnaryExpr,
    TrailingExpr,
    TupleIndexExpr,
    CallExpr,
    NativeExpr,
    LambdaExpr,
    ArrayExpr,
    StructExpr,
    TupleExpr,
    PrimativeExpr,
    IdentExpr,
    GenericExpr,
    ScopedExpr,

    /* types */
    VoidType,
    BoolType,
    UintType,
    IntType,
    FloatType,
    PtrType,
    ArrayType,
    FnType,
    TupleType,
    IdentType,
    GenericType,
    ScopedType,

    /* patterns */
    IdentPattern,
    DestructPattern,
    ArrayPattern,
    TuplePattern,

    /* shared */
    ScopedIdentifier,
    ScopeSegment,
    Identifier,
    Poison,
}